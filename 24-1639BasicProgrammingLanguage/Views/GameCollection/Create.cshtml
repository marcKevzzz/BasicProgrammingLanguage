@{
    ViewData["Title"] = "Add Game";
}

<div class="mb-4">
    <h1 class="hero-title">Add Video Game</h1>
    <p class="hero-subtitle mb-0">Record a new title in your gaming catalog with platform and rating.</p>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="apple-card">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger rounded-4 border-0 mb-4" role="alert">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                    @ViewBag.Error
                </div>
            }

            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="title" class="form-apple-label">Game Title <span class="text-danger">*</span></label>
                    <input type="text" id="title" name="title" value="@ViewBag.TitleInput" class="form-apple-input" placeholder="e.g. Elden Ring" required />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label for="genre" class="form-apple-label">Genre</label>
                        <input type="text" id="genre" name="genre" value="@ViewBag.GenreInput" class="form-apple-input" placeholder="e.g. Action RPG" />
                    </div>
                    <div class="col-6">
                        <label for="platform" class="form-apple-label">Platform</label>
                        <select id="platform" name="platform" class="form-apple-select">
                            <option value="PC">🖥️ PC (Steam / Epic)</option>
                            <option value="PlayStation 5">🎮 PlayStation 5</option>
                            <option value="Nintendo Switch">🕹️ Nintendo Switch</option>
                            <option value="Xbox Series X">🟢 Xbox Series X</option>
                            <option value="Mobile / iOS">📱 Mobile / iOS</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label for="status" class="form-apple-label">Completion Status</label>
                        <select id="status" name="status" class="form-apple-select">
                            <option value="Backlog" selected>📦 Backlog (Unplayed)</option>
                            <option value="In Progress">⚔️ In Progress (Active)</option>
                            <option value="Completed">🏆 Completed</option>
                            <option value="Abandoned">⏹️ Abandoned</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label for="rating" class="form-apple-label">Rating (1 to 5 Stars)</label>
                        <select id="rating" name="rating" class="form-apple-select">
                            <option value="5" selected>⭐⭐⭐⭐⭐ (5/5 Masterpiece)</option>
                            <option value="4">⭐⭐⭐⭐ (4/5 Great)</option>
                            <option value="3">⭐⭐⭐ (3/5 Good)</option>
                            <option value="2">⭐⭐ (2/5 Mediocre)</option>
                            <option value="1">⭐ (1/5 Poor)</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-check-lg"></i> Add to Collection
                    </button>
                    <a asp-action="Index" class="btn-apple-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
