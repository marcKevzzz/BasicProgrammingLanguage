@{
    ViewData["Title"] = "Edit Game";
    var game = ViewBag.Game as Dictionary<string, object> ?? new();
    int id = Convert.ToInt32(game.GetValueOrDefault("id", 0));
    string pf = game.GetValueOrDefault("platform")?.ToString() ?? "PC";
    string st = game.GetValueOrDefault("status")?.ToString() ?? "Backlog";
    int rating = Convert.ToInt32(game.GetValueOrDefault("rating", 5));
}

<div class="mb-4">
    <h1 class="hero-title">Edit Game Details</h1>
    <p class="hero-subtitle mb-0">Update game details and play status for #@id.</p>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="apple-card">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger rounded-4 border-0 mb-4" role="alert">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                    @ViewBag.Error
                </div>
            }

            <form method="post" asp-action="Edit" asp-route-id="@id">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="title" class="form-apple-label">Game Title <span class="text-danger">*</span></label>
                    <input type="text" id="title" name="title" value="@game.GetValueOrDefault("title")" class="form-apple-input" required />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label for="genre" class="form-apple-label">Genre</label>
                        <input type="text" id="genre" name="genre" value="@game.GetValueOrDefault("genre")" class="form-apple-input" />
                    </div>
                    <div class="col-6">
                        <label for="platform" class="form-apple-label">Platform</label>
                        <select id="platform" name="platform" class="form-apple-select">
                            <option value="PC" selected="@(pf == "PC")">🖥️ PC</option>
                            <option value="PlayStation 5" selected="@(pf == "PlayStation 5")">🎮 PlayStation 5</option>
                            <option value="Nintendo Switch" selected="@(pf == "Nintendo Switch")">🕹️ Nintendo Switch</option>
                            <option value="Xbox Series X" selected="@(pf == "Xbox Series X")">🟢 Xbox Series X</option>
                            <option value="Mobile / iOS" selected="@(pf == "Mobile / iOS")">📱 Mobile / iOS</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label for="status" class="form-apple-label">Completion Status</label>
                        <select id="status" name="status" class="form-apple-select">
                            <option value="Backlog" selected="@(st == "Backlog")">📦 Backlog</option>
                            <option value="In Progress" selected="@(st == "In Progress")">⚔️ In Progress</option>
                            <option value="Completed" selected="@(st == "Completed")">🏆 Completed</option>
                            <option value="Abandoned" selected="@(st == "Abandoned")">⏹️ Abandoned</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label for="rating" class="form-apple-label">Rating (1 to 5 Stars)</label>
                        <select id="rating" name="rating" class="form-apple-select">
                            <option value="5" selected="@(rating == 5)">⭐⭐⭐⭐⭐ (5/5)</option>
                            <option value="4" selected="@(rating == 4)">⭐⭐⭐⭐ (4/5)</option>
                            <option value="3" selected="@(rating == 3)">⭐⭐⭐ (3/5)</option>
                            <option value="2" selected="@(rating == 2)">⭐⭐ (2/5)</option>
                            <option value="1" selected="@(rating == 1)">⭐ (1/5)</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn-apple-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
