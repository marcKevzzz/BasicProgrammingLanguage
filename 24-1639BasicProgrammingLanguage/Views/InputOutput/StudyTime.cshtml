@{
    ViewData["Title"] = "Study Time Calculator";
    var entries = ViewBag.Entries as List<Dictionary<string, object>>;
}

<!-- Header -->
<div class="mb-4">
    <h1 class="hero-title">Study Time Calculator</h1>
    <p class="hero-subtitle mb-0">Find your total and average study hours.</p>
</div>

<div class="row g-4 mb-5">
    <!-- Input Section -->
    <div class="col-12 col-lg-7">
        <div class="apple-card h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-book fs-5 text-primary"></i>
                    <h2 class="h5 fw-bold mb-0">Academic Subjects</h2>
                </div>
                <button type="button" class="btn btn-sm btn-apple-secondary" id="btnAddSubject">
                    <i class="bi bi-plus-circle"></i> Add Subject
                </button>
            </div>

            <form method="post" asp-action="StudyTime" id="studyForm">
                @Html.AntiForgeryToken()

                <div id="subjectRowsContainer" class="d-flex flex-column gap-2 mb-3">
                    @if (entries != null && entries.Count > 0)
                    {
                        for (int i = 0; i < entries.Count; i++)
                        {
                            <div class="row g-2 align-items-center subject-row">
                                <div class="col-7">
                                    <input type="text" name="subjectNames" class="form-apple-input" value="@entries[i]["subject"]" placeholder="e.g. Data Structures" required />
                                </div>
                                <div class="col-4">
                                    <input type="number" name="studyHours" class="form-apple-input" value="@entries[i]["hours"]" step="0.25" min="0.1" max="24" placeholder="Hours" required />
                                </div>
                                <div class="col-1 text-center">
                                    <button type="button" class="btn btn-sm text-danger btn-remove-row" title="Remove" aria-label="Remove"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Default 3 Starter Rows -->
                        <div class="row g-2 align-items-center subject-row">
                            <div class="col-7">
                                <input type="text" name="subjectNames" class="form-apple-input" value="Algorithms & Data Structures" placeholder="Subject Name" required />
                            </div>
                            <div class="col-4">
                                <input type="number" name="studyHours" class="form-apple-input" value="3.5" step="0.25" min="0.1" max="24" placeholder="Hours" required />
                            </div>
                            <div class="col-1 text-center">
                                <button type="button" class="btn btn-sm text-danger btn-remove-row" title="Remove" aria-label="Remove"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                        <div class="row g-2 align-items-center subject-row">
                            <div class="col-7">
                                <input type="text" name="subjectNames" class="form-apple-input" value="Discrete Mathematics" placeholder="Subject Name" required />
                            </div>
                            <div class="col-4">
                                <input type="number" name="studyHours" class="form-apple-input" value="2.0" step="0.25" min="0.1" max="24" placeholder="Hours" required />
                            </div>
                            <div class="col-1 text-center">
                                <button type="button" class="btn btn-sm text-danger btn-remove-row" title="Remove" aria-label="Remove"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                        <div class="row g-2 align-items-center subject-row">
                            <div class="col-7">
                                <input type="text" name="subjectNames" class="form-apple-input" value="Web Systems Development" placeholder="Subject Name" required />
                            </div>
                            <div class="col-4">
                                <input type="number" name="studyHours" class="form-apple-input" value="2.5" step="0.25" min="0.1" max="24" placeholder="Hours" required />
                            </div>
                            <div class="col-1 text-center">
                                <button type="button" class="btn btn-sm text-danger btn-remove-row" title="Remove" aria-label="Remove"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex align-items-center gap-2 pt-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-calculator"></i> Calculate Study Metrics
                    </button>
                    <a asp-action="StudyTime" class="btn-apple-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Output Section -->
    <div class="col-12 col-lg-5">
        <div class="apple-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="panel-heading d-flex align-items-center gap-2 mb-3">
                    <h2 class="h5 fw-bold mb-0">Study Time Summary</h2>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger rounded-4 border-0 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i>
                        @ViewBag.Error
                    </div>
                }
                else if (ViewBag.Success == true)
                {
                    <div class="output-hero-panel mb-3">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="text-secondary small fw-bold text-uppercase">Total Hours</div>
                                <div class="output-value-large">
                                    @string.Format("{0:F1}", ViewBag.TotalHours) <span class="fs-6 text-secondary fw-normal">hrs</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-secondary small fw-bold text-uppercase">Average / Subject</div>
                                <div class="output-value-large text-success">
                                    @string.Format("{0:F2}", ViewBag.AverageHours) <span class="fs-6 text-secondary fw-normal">hrs</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (entries != null)
                    {
                        <div class="table-responsive rounded-3 border">
                            <table class="table table-sm table-hover mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>Subject</th>
                                        <th class="text-end">Hours</th>
                                        <th class="text-end">% of Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in entries)
                                    {
                                        double h = Convert.ToDouble(item["hours"]);
                                        double pct = ViewBag.TotalHours > 0 ? (h / (double)ViewBag.TotalHours) * 100 : 0;
                                        <tr>
                                            <td class="fw-medium">@item["subject"]</td>
                                            <td class="text-end">@h.ToString("F1") hrs</td>
                                            <td class="text-end text-secondary">@pct.ToString("F0")%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="bi bi-mortarboard fs-1 mb-2 d-block opacity-50"></i>
                        <p class="mb-0">Add subjects and durations, then click <strong>Calculate Study Metrics</strong>.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content">
<div class="row g-4">
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Array &amp; Collection Processing</h6>
            <p class="text-secondary small">
                Form inputs are posted as arrays (<code>string[] subjectNames</code> and <code>double[] studyHours</code>). The C# controller loops through the inputs, verifies individual bounds, sums the total hours, and computes the arithmetic mean:
            </p>
            <div class="p-3 rounded-3 bg-light border font-monospace small">
                Total = &sum;(Hours)<br />
                Average = Total &divide; Count(Subjects)
            </div>
        </div>
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Sample Calculation</h6>
            <div class="p-3 rounded-3 bg-light border small">
                <strong>Subject 1:</strong> Math (3.0 hrs)<br />
                <strong>Subject 2:</strong> Science (2.5 hrs)<br />
                <strong>Subject 3:</strong> History (1.5 hrs)<br />
                <hr class="my-2" />
                <strong>Total Study Time:</strong> 7.0 hours<br />
                <strong>Average per Subject:</strong> 2.33 hours
            </div>
        </div>
    </div>
    </div>
</details>

<!-- View C# Logic Section -->
<details class="lesson-details">
    <summary>C# code</summary>
    <div class="lesson-content">
<div class="lesson-body" id="studyLogicPanel">
        <div class="macos-code-box">
            <div class="macos-code-header">
                <div class="traffic-dots">
                    <span class="dot dot-red"></span>
                    <span class="dot dot-yellow"></span>
                    <span class="dot dot-green"></span>
                </div>
                <div class="code-title">InputOutputController.cs — StudyTime</div>
                <button type="button" class="btn-copy-code" data-code-target="studyCode">
                    <i class="bi bi-clipboard"></i> Copy Code
                </button>
            </div>
            <pre class="macos-code-body" id="studyCode"><code>[HttpPost]
[ValidateAntiForgeryToken]
public IActionResult StudyTime(string[]? subjectNames, double[]? studyHours)
{
    if (subjectNames == null || studyHours == null || subjectNames.Length == 0)
    {
        ViewBag.Error = "Please enter at least one academic subject and its study duration.";
        return View();
    }

    var entries = new List&lt;Dictionary&lt;string, object&gt;&gt;();
    double totalHours = 0;

    for (int i = 0; i &lt; subjectNames.Length &amp;&amp; i &lt; studyHours.Length; i++)
    {
        string name = (subjectNames[i] ?? "").Trim();
        double hours = studyHours[i];

        if (string.IsNullOrWhiteSpace(name)) continue;
        if (hours &lt; 0 || hours &gt; 24)
        {
            ViewBag.Error = $"Study hours for '{name}' must be between 0 and 24 hours.";
            return View();
        }

        totalHours += hours;
        entries.Add(new Dictionary&lt;string, object&gt;
        {
            ["subject"] = name,
            ["hours"] = hours
        });
    }

    double averageHours = entries.Count &gt; 0 ? totalHours / entries.Count : 0;

    ViewBag.Entries = entries;
    ViewBag.TotalHours = totalHours;
    ViewBag.AverageHours = averageHours;
    ViewBag.Success = true;
    return View();
}</code></pre>
        </div>
    </div>
    </div>
</details>

@section Scripts {
    <script>
        document.getElementById('btnAddSubject').addEventListener('click', () => {
            const container = document.getElementById('subjectRowsContainer');
            const row = document.createElement('div');
            row.className = 'row g-2 align-items-center subject-row';
            row.innerHTML = `
                <div class="col-7">
                    <input type="text" name="subjectNames" class="form-apple-input" placeholder="Subject Name" required />
                </div>
                <div class="col-4">
                    <input type="number" name="studyHours" class="form-apple-input" value="1.0" step="0.25" min="0.1" max="24" placeholder="Hours" required />
                </div>
                <div class="col-1 text-center">
                    <button type="button" class="btn btn-sm text-danger btn-remove-row" title="Remove" aria-label="Remove"><i class="bi bi-trash"></i></button>
                </div>
            `;
            container.appendChild(row);
            attachRowRemove(row);
        });

        function attachRowRemove(containerEl) {
            containerEl.querySelectorAll('.btn-remove-row').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const row = e.target.closest('.subject-row');
                    const allRows = document.querySelectorAll('.subject-row');
                    if (allRows.length > 1) {
                        row.remove();
                    } else {
                        alert('At least one subject row must be maintained.');
                    }
                });
            });
        }

        attachRowRemove(document);
    </script>
}
