@{
    ViewData["Title"] = "Electricity Bill Estimator";
}

<!-- Header -->
<div class="mb-4">
    <h1 class="hero-title">Electricity Bill Estimator</h1>
    <p class="hero-subtitle mb-0">Estimate your bill from electricity usage and rate.</p>
</div>

<div class="row g-4 mb-5">
    <!-- Input Section -->
    <div class="col-12 col-lg-6">
        <div class="apple-card h-100">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-lightning-charge fs-5 text-warning"></i>
                <h2 class="h5 fw-bold mb-0">Consumption Details</h2>
            </div>

            <form method="post" asp-action="ElectricityBill">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="consumption" class="form-apple-label">Monthly Energy Consumption (kWh) <span class="text-danger">*</span></label>
                    <input type="number" 
                           id="consumption" 
                           name="consumption" 
                           value="@ViewBag.Consumption" 
                           min="0" 
                           max="50000" 
                           step="0.5" 
                           class="form-apple-input" 
                           placeholder="e.g. 240.5" 
                           required />
                    <div class="form-text text-secondary small">Total meter consumption reading in kilowatt-hours.</div>
                </div>

                <div class="mb-3">
                    <label for="rate" class="form-apple-label">Tariff Rate per kWh (₱ / kWh) <span class="text-danger">*</span></label>
                    <input type="number" 
                           id="rate" 
                           name="rate" 
                           value="@ViewBag.Rate" 
                           min="0.1" 
                           max="500" 
                           step="0.01" 
                           class="form-apple-input" 
                           placeholder="e.g. 11.85" 
                           required />
                    <div class="form-text text-secondary small">Typical Meralco/electric cooperative rate (₱10 - ₱13 / kWh).</div>
                </div>

                <div class="d-flex align-items-center gap-2 pt-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-calculator"></i> Estimate Bill
                    </button>
                    <a asp-action="ElectricityBill" class="btn-apple-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Output Section -->
    <div class="col-12 col-lg-6">
        <div class="apple-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-receipt-cutoff fs-5 text-primary"></i>
                    <h2 class="h5 fw-bold mb-0">Estimated Power Invoice</h2>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger rounded-4 border-0 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i>
                        @ViewBag.Error
                    </div>
                }
                else if (ViewBag.Success == true)
                {
                    <div class="output-hero-panel">
                        <div class="text-secondary small fw-bold text-uppercase mb-1">Estimated Monthly Bill</div>
                        <div class="output-value-large text-warning">
                            ₱@string.Format("{0:N2}", ViewBag.TotalBill)
                        </div>
                        <div class="mt-3 pt-3 border-top d-flex justify-content-between text-secondary small">
                            <span>Billed Consumption:</span>
                            <span class="fw-semibold text-dark">@string.Format("{0:F1}", ViewBag.Consumption) kWh</span>
                        </div>
                        <div class="d-flex justify-content-between text-secondary small mt-1">
                            <span>Applicable Generation Rate:</span>
                            <span class="fw-semibold text-dark">₱@string.Format("{0:F2}", ViewBag.Rate) / kWh</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="bi bi-plug fs-1 mb-2 d-block opacity-50"></i>
                        <p class="mb-0">Enter kWh consumption and electricity tariff, then click <strong>Estimate Bill</strong>.</p>
                    </div>
                }
            </div>

            <div class="mt-4 pt-3 border-top text-secondary small">
                <i class="bi bi-info-circle me-1"></i> Exact formula: <code>Total = Consumption &times; Rate</code>.
            </div>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content">
<div class="row g-4">
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Kilowatt-Hour Electricity Formula</h6>
            <p class="text-secondary small">
                Power utility bill estimations execute linear multiplication between the volume of electrical energy consumed (measured in kWh) and the contracted rate per unit.
            </p>
            <div class="p-3 rounded-3 bg-light border font-monospace small">
                Estimated Bill = Consumption (kWh) &times; Rate (₱/kWh)
            </div>
        </div>
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Standard Benchmarks</h6>
            <div class="table-responsive">
                <table class="table table-sm table-bordered small">
                    <thead class="table-light">
                        <tr>
                            <th>Consumption Tier</th>
                            <th>Avg. Rate</th>
                            <th>Estimated Bill</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>100 kWh (Lifeline)</td>
                            <td>₱11.50</td>
                            <td>₱1,150.00</td>
                        </tr>
                        <tr>
                            <td>200 kWh (Small Household)</td>
                            <td>₱11.85</td>
                            <td>₱2,370.00</td>
                        </tr>
                        <tr>
                            <td>450 kWh (Air-conditioned)</td>
                            <td>₱12.20</td>
                            <td>₱5,490.00</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </div>
</details>

<!-- View C# Logic Section -->
<details class="lesson-details">
    <summary>C# code</summary>
    <div class="lesson-content">
<div class="lesson-body" id="electricLogicPanel">
        <div class="macos-code-box">
            <div class="macos-code-header">
                <div class="traffic-dots">
                    <span class="dot dot-red"></span>
                    <span class="dot dot-yellow"></span>
                    <span class="dot dot-green"></span>
                </div>
                <div class="code-title">InputOutputController.cs — ElectricityBill</div>
                <button type="button" class="btn-copy-code" data-code-target="electricCode">
                    <i class="bi bi-clipboard"></i> Copy Code
                </button>
            </div>
            <pre class="macos-code-body" id="electricCode"><code>[HttpPost]
[ValidateAntiForgeryToken]
public IActionResult ElectricityBill(double? consumption, double? rate)
{
    if (!consumption.HasValue || consumption.Value &lt; 0)
    {
        ViewBag.Error = "Electricity consumption cannot be negative.";
        return View();
    }

    if (!rate.HasValue || rate.Value &lt;= 0)
    {
        ViewBag.Error = "Rate per kWh must be greater than zero.";
        return View();
    }

    double totalBill = consumption.Value * rate.Value;

    ViewBag.Consumption = consumption.Value;
    ViewBag.Rate = rate.Value;
    ViewBag.TotalBill = totalBill;
    ViewBag.Success = true;
    return View();
}</code></pre>
        </div>
    </div>
    </div>
</details>
