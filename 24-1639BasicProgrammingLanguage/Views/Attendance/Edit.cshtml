@{
    ViewData["Title"] = "Edit Attendance";
    var record = ViewBag.Record as Dictionary<string, object> ?? new();
    int id = Convert.ToInt32(record.GetValueOrDefault("id", 0));
    string st = record.GetValueOrDefault("status")?.ToString() ?? "Present";
}

<div class="mb-4">
    <h1 class="hero-title">Edit Attendance Record</h1>
    <p class="hero-subtitle mb-0">Update attendance record #@id.</p>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="apple-card">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger rounded-4 border-0 mb-4" role="alert">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                    @ViewBag.Error
                </div>
            }

            <form method="post" asp-action="Edit" asp-route-id="@id">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="name" class="form-apple-label">Full Student Name <span class="text-danger">*</span></label>
                    <input type="text" id="name" name="name" value="@record.GetValueOrDefault("name")" class="form-apple-input" required />
                </div>

                <div class="mb-3">
                    <label for="studentNumber" class="form-apple-label">Student ID Number <span class="text-danger">*</span></label>
                    <input type="text" id="studentNumber" name="studentNumber" value="@record.GetValueOrDefault("studentNumber")" class="form-apple-input" required />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-7">
                        <label for="course" class="form-apple-label">Academic Program</label>
                        <input type="text" id="course" name="course" value="@record.GetValueOrDefault("course")" class="form-apple-input" />
                    </div>
                    <div class="col-5">
                        <label for="section" class="form-apple-label">Section</label>
                        <input type="text" id="section" name="section" value="@record.GetValueOrDefault("section")" class="form-apple-input" />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label for="date" class="form-apple-label">Date</label>
                        <input type="date" id="date" name="date" value="@record.GetValueOrDefault("date")" class="form-apple-input" />
                    </div>
                    <div class="col-6">
                        <label for="status" class="form-apple-label">Status</label>
                        <select id="status" name="status" class="form-apple-select">
                            <option value="Present" selected="@(st == "Present")">🟢 Present</option>
                            <option value="Late" selected="@(st == "Late")">🟡 Late</option>
                            <option value="Absent" selected="@(st == "Absent")">🔴 Absent</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn-apple-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
