@{
    ViewData["Title"] = "New Attendance Record";
}

<div class="mb-4">
    <h1 class="hero-title">New Attendance Record</h1>
    <p class="hero-subtitle mb-0">Enter the student, date, and attendance status.</p>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="apple-card">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger rounded-4 border-0 mb-4" role="alert">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                    @ViewBag.Error
                </div>
            }

            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="name" class="form-apple-label">Full Student Name <span class="text-danger">*</span></label>
                    <input type="text" id="name" name="name" value="@ViewBag.NameInput" class="form-apple-input" placeholder="e.g. Angelica Marie Santos" required />
                </div>

                <div class="mb-3">
                    <label for="studentNumber" class="form-apple-label">Student ID Number <span class="text-danger">*</span></label>
                    <input type="text" id="studentNumber" name="studentNumber" value="@ViewBag.StudentNumberInput" class="form-apple-input" placeholder="e.g. 2024-01299" required />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-7">
                        <label for="course" class="form-apple-label">Academic Degree Program</label>
                        <input type="text" id="course" name="course" value="@(ViewBag.CourseInput ?? "BS Computer Science")" class="form-apple-input" />
                    </div>
                    <div class="col-5">
                        <label for="section" class="form-apple-label">Class Section</label>
                        <input type="text" id="section" name="section" value="@(ViewBag.SectionInput ?? "CS-2B")" class="form-apple-input" />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label for="date" class="form-apple-label">Attendance Date</label>
                        <input type="date" id="date" name="date" value="@(ViewBag.DateInput ?? DateTime.Now.ToString("yyyy-MM-dd"))" class="form-apple-input" />
                    </div>
                    <div class="col-6">
                        <label for="status" class="form-apple-label">Attendance Status</label>
                        <select id="status" name="status" class="form-apple-select">
                            <option value="Present" selected>🟢 Present</option>
                            <option value="Late">🟡 Late</option>
                            <option value="Absent">🔴 Absent</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-check-lg"></i> Log Record
                    </button>
                    <a asp-action="Index" class="btn-apple-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
