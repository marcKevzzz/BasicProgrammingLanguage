@{
    ViewData["Title"] = "Edit Report";
    var report = ViewBag.Report as Dictionary<string, object> ?? new();
    int id = Convert.ToInt32(report.GetValueOrDefault("id", 0));
    string st = report.GetValueOrDefault("status")?.ToString() ?? "Found";
}

<div class="mb-4">
    <h1 class="hero-title">Edit Item Report</h1>
    <p class="hero-subtitle mb-0">Update information and resolution status for report #@id.</p>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="apple-card">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger rounded-4 border-0 mb-4" role="alert">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                    @ViewBag.Error
                </div>
            }

            <form method="post" asp-action="Edit" asp-route-id="@id">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="name" class="form-apple-label">Item Name / Title <span class="text-danger">*</span></label>
                    <input type="text" id="name" name="name" value="@report.GetValueOrDefault("name")" class="form-apple-input" required />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-apple-label">Detailed Description</label>
                    <textarea id="description" name="description" class="form-apple-input" rows="3">@report.GetValueOrDefault("description")</textarea>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-apple-label">Location <span class="text-danger">*</span></label>
                    <input type="text" id="location" name="location" value="@report.GetValueOrDefault("location")" class="form-apple-input" required />
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label for="date" class="form-apple-label">Date</label>
                        <input type="date" id="date" name="date" value="@report.GetValueOrDefault("date")" class="form-apple-input" />
                    </div>
                    <div class="col-6">
                        <label for="status" class="form-apple-label">Status Classification</label>
                        <select id="status" name="status" class="form-apple-select">
                            <option value="Found" selected="@(st == "Found")">🟢 Found</option>
                            <option value="Lost" selected="@(st == "Lost")">🔴 Lost</option>
                            <option value="Claimed" selected="@(st == "Claimed")">⚪ Claimed</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn-apple-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
