@{
    ViewData["Title"] = "Number Guessing Game";
    var history = ViewBag.History as List<string>;
    bool isWon = ViewBag.IsWon == true;
}

<!-- Header -->
<div class="mb-4">
    <h1 class="hero-title">Number Guessing Game</h1>
    <p class="hero-subtitle mb-0">Guess a number between 1 and 100.</p>
</div>

<div class="row g-4 mb-5">
    <!-- Input Section -->
    <div class="col-12 col-lg-5">
        <div class="apple-card h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-dice-5 fs-5 text-primary"></i>
                    <h2 class="h5 fw-bold mb-0">Submit Guess</h2>
                </div>
                <span class="badge bg-light text-secondary border rounded-pill px-3 py-1">
                    Attempt #@(ViewBag.Attempts ?? 0)
                </span>
            </div>

            @if (isWon)
            {
                <div class="p-4 text-center rounded-4 bg-success-subtle text-success border border-success-subtle mb-4">
                    <i class="bi bi-trophy-fill fs-1 d-block mb-2 text-warning"></i>
                    <h4 class="fw-bold">Victory Achieved!</h4>
                    <p class="small mb-3">You discovered the secret number in <strong>@ViewBag.Attempts</strong> attempt(s)!</p>
                    <form method="post" asp-action="NumberGuessing">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="restart" />
                        <button type="submit" class="btn-apple-primary">
                            <i class="bi bi-arrow-clockwise"></i> Play Again (New Number)
                        </button>
                    </form>
                </div>
            }
            else
            {
                <form method="post" asp-action="NumberGuessing">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="guess" class="form-apple-label">Your Guess (1 &ndash; 100) <span class="text-danger">*</span></label>
                        <input type="number" 
                               id="guess" 
                               name="guess" 
                               min="1" 
                               max="100" 
                               class="form-apple-input" 
                               placeholder="e.g. 50" 
                               autofocus 
                               required />
                        <div class="form-text text-secondary small">Pick any integer between 1 and 100.</div>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-2">
                        <button type="submit" class="btn-apple-primary flex-grow-1">
                            <i class="bi bi-bullseye"></i> Submit Guess
                        </button>
                    </div>
                </form>

                <div class="mt-3 pt-3 border-top">
                    <form method="post" asp-action="NumberGuessing">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="restart" />
                        <button type="submit" class="btn btn-sm btn-apple-secondary w-100">
                            <i class="bi bi-arrow-counterclockwise"></i> Restart Game (Reset Secret Number)
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Output Section -->
    <div class="col-12 col-lg-7">
        <div class="apple-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-activity fs-5 text-primary"></i>
                        <h2 class="h5 fw-bold mb-0">Game State &amp; Feedback</h2>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small">
                        Session State Active
                    </span>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger rounded-4 border-0 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i>
                        @ViewBag.Error
                    </div>
                }

                @if (ViewBag.Message != null)
                {
                    var msgType = ViewBag.MessageType?.ToString() ?? "info";
                    var alertClass = msgType == "success" ? "alert-success" :
                                     msgType == "warning" ? "alert-warning" :
                                     msgType == "primary" ? "alert-info" : "alert-light border";

                    <div class="alert @alertClass rounded-4 shadow-sm py-3 px-4 mb-3" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi @(msgType == "success" ? "bi-check-circle-fill" : msgType == "warning" ? "bi-arrow-down-circle" : "bi-arrow-up-circle") fs-4"></i>
                            <span class="fs-5 fw-semibold">@ViewBag.Message</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="p-4 rounded-4 bg-light border text-center text-secondary mb-3">
                        <i class="bi bi-question-circle fs-2 d-block mb-1 text-primary"></i>
                        <p class="mb-0">A secret number between 1 and 100 has been picked in your private session. Enter your first guess!</p>
                    </div>
                }

                @if (history != null && history.Count > 0)
                {
                    <div class="mt-3">
                        <div class="text-secondary small fw-bold text-uppercase mb-2">Guess Trajectory History</div>
                        <div class="list-group list-group-flush rounded-3 border small overflow-auto" style="max-height: 200px;">
                            @foreach (var h in history)
                            {
                                <div class="list-group-item bg-transparent py-2 d-flex align-items-center gap-2">
                                    <i class="bi @(h.Contains("Correct") ? "bi-check-circle-fill text-success" : h.Contains("Too High") ? "bi-arrow-down-short text-warning fs-5" : "bi-arrow-up-short text-primary fs-5")"></i>
                                    <span>@h</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="mt-4 pt-3 border-top text-secondary small">
                <i class="bi bi-info-circle me-1"></i> Interactive game loop maintained across HTTP requests via ASP.NET Core session state.
            </div>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content">
<div class="row g-4">
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Binary Search &amp; Game Loop Logic</h6>
            <p class="text-secondary small">
                In computer science, a number guessing game represents an interactive execution of the <strong>Binary Search</strong> algorithm. By repeatedly halving the search space, any number between 1 and 100 can be mathematically discovered in at most &lceil;log<sub>2</sub>(100)&rceil; = <strong>7 attempts</strong>.
            </p>
        </div>
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Session State Management</h6>
            <p class="text-secondary small">
                Because HTTP is stateless, the server stores the generated random secret number inside <code>HttpContext.Session.GetInt32("SecretNumber")</code> along with the guess attempt counter. When the player clicks restart, the session variables are cleared.
            </p>
        </div>
    </div>
    </div>
</details>

<!-- View C# Logic Section -->
<details class="lesson-details">
    <summary>C# code</summary>
    <div class="lesson-content">
<div class="lesson-body" id="guessLogicPanel">
        <div class="macos-code-box">
            <div class="macos-code-header">
                <div class="traffic-dots">
                    <span class="dot dot-red"></span>
                    <span class="dot dot-yellow"></span>
                    <span class="dot dot-green"></span>
                </div>
                <div class="code-title">RepetitionController.cs — NumberGuessing</div>
                <button type="button" class="btn-copy-code" data-code-target="guessCode">
                    <i class="bi bi-clipboard"></i> Copy Code
                </button>
            </div>
            <pre class="macos-code-body" id="guessCode"><code>[HttpPost]
[ValidateAntiForgeryToken]
public IActionResult NumberGuessing(int? guess, string? action)
{
    if (action == "restart")
    {
        HttpContext.Session.Remove("SecretNumber");
        HttpContext.Session.Remove("GuessAttempts");
        return View();
    }

    int secret = HttpContext.Session.GetInt32("SecretNumber")!.Value;
    int attempts = (HttpContext.Session.GetInt32("GuessAttempts") ?? 0) + 1;
    HttpContext.Session.SetInt32("GuessAttempts", attempts);

    if (guess.Value == secret)
    {
        ViewBag.Message = $"Correct! Found in {attempts} attempt(s).";
        ViewBag.IsWon = true;
    }
    else if (guess.Value &gt; secret)
    {
        ViewBag.Message = $"{guess.Value} is Too High! Try a smaller number.";
    }
    else
    {
        ViewBag.Message = $"{guess.Value} is Too Low! Try a higher number.";
    }

    return View();
}</code></pre>
        </div>
    </div>
    </div>
</details>
