@{
    ViewData["Title"] = "PIN Verification System";
    bool isLocked = ViewBag.IsLocked == true;
    int remaining = ViewBag.RemainingAttempts ?? 3;
    string demoPin = ViewBag.DemoPin ?? "8024";
}

<!-- Header -->
<div class="mb-4">
    <h1 class="hero-title">PIN Verification System</h1>
    <p class="hero-subtitle mb-0">Enter the PIN. You have three attempts.</p>
</div>

<div class="row g-4 mb-5">
    <!-- Keypad Input Section -->
    <div class="col-12 col-lg-5">
        <div class="apple-card h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock fs-5 text-primary"></i>
                    <h2 class="h5 fw-bold mb-0">Security Terminal</h2>
                </div>
                <span class="apple-badge @(isLocked ? "badge-advanced" : remaining == 1 ? "badge-intermediate" : "badge-beginner")">
                    @(isLocked ? "TERMINAL LOCKED" : $"{remaining} Attempt(s) Left")
                </span>
            </div>

            <div class="p-3 mb-3 rounded-3 bg-light border text-center">
                <span class="text-secondary small d-block">Educational Demo Predefined PIN:</span>
                <span class="fs-4 fw-bold font-monospace text-primary tracking-widest">@demoPin</span>
            </div>

            @if (isLocked)
            {
                <div class="alert alert-danger rounded-4 py-4 text-center border-0 shadow-sm mb-3">
                    <i class="bi bi-shield-slash-fill fs-1 text-danger d-block mb-2"></i>
                    <h5 class="fw-bold">Security Lockout Active</h5>
                    <p class="small mb-3">The terminal has engaged lockout protection after 3 failed PIN attempts.</p>
                    <form method="post" asp-action="PinVerification">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="reset" />
                        <button type="submit" class="btn-apple-primary">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset Terminal Demo
                        </button>
                    </form>
                </div>
            }
            else
            {
                <form method="post" asp-action="PinVerification" id="pinForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-3 text-center">
                        <label for="pinInput" class="form-apple-label">Enter 4-Digit Security PIN</label>
                        <input type="password" 
                               id="pinInput" 
                               name="pin" 
                               maxlength="4" 
                               class="form-apple-input fs-2 text-center font-monospace fw-bold tracking-widest py-2" 
                               placeholder="••••" 
                               autocomplete="off" 
                               required />
                    </div>

                    <!-- Touch Screen Keypad Simulation -->
                    <div class="row g-2 mb-3">
                        @for (int i = 1; i <= 9; i++)
                        {
                            int num = i;
                            <div class="col-4">
                                <button type="button" class="btn btn-light w-100 py-2 fs-5 fw-bold border keypad-btn" data-val="@num">@num</button>
                            </div>
                        }
                        <div class="col-4">
                            <button type="button" class="btn btn-outline-secondary w-100 py-2 border keypad-clear"><i class="bi bi-backspace"></i></button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn btn-light w-100 py-2 fs-5 fw-bold border keypad-btn" data-val="0">0</button>
                        </div>
                        <div class="col-4">
                            <button type="submit" class="btn btn-primary w-100 py-2 border"><i class="bi bi-check-lg"></i></button>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-2">
                        <button type="submit" class="btn-apple-primary flex-grow-1">
                            <i class="bi bi-unlock"></i> Verify PIN
                        </button>
                    </div>
                </form>

                <div class="mt-3 pt-3 border-top">
                    <form method="post" asp-action="PinVerification">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="reset" />
                        <button type="submit" class="btn btn-sm btn-apple-secondary w-100">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset Demo Attempts
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Output Section -->
    <div class="col-12 col-lg-7">
        <div class="apple-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-display fs-5 text-primary"></i>
                        <h2 class="h5 fw-bold mb-0">Terminal Response Status</h2>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small">
                        Session Protected
                    </span>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger rounded-4 border-0 shadow-sm py-3 mb-3" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-x-circle-fill fs-4 text-danger"></i>
                            <span class="fw-semibold">@ViewBag.Error</span>
                        </div>
                    </div>
                }

                @if (ViewBag.Message != null)
                {
                    var msgType = ViewBag.MessageType?.ToString() ?? "info";
                    <div class="alert @(msgType == "success" ? "alert-success" : "alert-info") rounded-4 border-0 shadow-sm py-3 mb-3" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi @(msgType == "success" ? "bi-check-circle-fill text-success" : "bi-info-circle-fill text-primary") fs-4"></i>
                            <span class="fs-5 fw-semibold">@ViewBag.Message</span>
                        </div>
                    </div>
                }
                else if (ViewBag.Error == null)
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="bi bi-shield-check fs-1 mb-2 d-block opacity-50"></i>
                        <p class="mb-0">Key in the demonstration PIN (<strong>@demoPin</strong>) or test incorrect entries to observe attempt decrement counters.</p>
                    </div>
                }

                <!-- Attempt Indicators (3 Dots) -->
                <div class="p-3 rounded-4 bg-light border mt-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-semibold text-secondary text-uppercase">Attempt Quota Status</span>
                        <span class="small fw-bold @(remaining == 0 ? "text-danger" : "text-dark")">@remaining / 3 attempts remaining</span>
                    </div>
                    <div class="d-flex gap-2">
                        <div class="flex-grow-1 p-2 rounded-3 text-center small fw-semibold @(remaining >= 1 ? "bg-success text-white" : "bg-danger text-white")">
                            Attempt 1 @(remaining >= 1 ? "✓" : "✗")
                        </div>
                        <div class="flex-grow-1 p-2 rounded-3 text-center small fw-semibold @(remaining >= 2 ? "bg-success text-white" : "bg-danger text-white")">
                            Attempt 2 @(remaining >= 2 ? "✓" : "✗")
                        </div>
                        <div class="flex-grow-1 p-2 rounded-3 text-center small fw-semibold @(remaining >= 3 ? "bg-success text-white" : "bg-danger text-white")">
                            Attempt 3 @(remaining >= 3 ? "✓" : "✗")
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top text-secondary small">
                <i class="bi bi-exclamation-triangle text-warning me-1"></i> Educational simulation demonstrating finite attempt loops and state lockouts.
            </div>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content">
<div class="row g-4">
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Finite Attempt While/Decrement Loop</h6>
            <p class="text-secondary small">
                A security verification loop tracks a finite counter (<code>remainingAttempts = 3</code>). Each invalid submission decrements the balance. When the counter reaches zero, the state permanently locks until administrative reset:
            </p>
            <div class="p-3 rounded-3 bg-light border font-monospace small">
                if (pin != DEMO_PIN)<br />
                {<br />
                &nbsp;&nbsp;&nbsp;&nbsp;remaining--;<br />
                &nbsp;&nbsp;&nbsp;&nbsp;if (remaining &le; 0) isLocked = true;<br />
                }
            </div>
        </div>
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Security Best Practices</h6>
            <p class="text-secondary small">
                In real world banking hardware (EMV chip cards and HSMs), physical rate-limiting prevents offline brute-forcing. After 3 bad attempts, hardware fuses or counters invalidate the chip.
            </p>
        </div>
    </div>
    </div>
</details>

<!-- View C# Logic Section -->
<details class="lesson-details">
    <summary>C# code</summary>
    <div class="lesson-content">
<div class="lesson-body" id="pinLogicPanel">
        <div class="macos-code-box">
            <div class="macos-code-header">
                <div class="traffic-dots">
                    <span class="dot dot-red"></span>
                    <span class="dot dot-yellow"></span>
                    <span class="dot dot-green"></span>
                </div>
                <div class="code-title">RepetitionController.cs — PinVerification</div>
                <button type="button" class="btn-copy-code" data-code-target="pinCode">
                    <i class="bi bi-clipboard"></i> Copy Code
                </button>
            </div>
            <pre class="macos-code-body" id="pinCode"><code>[HttpPost]
[ValidateAntiForgeryToken]
public IActionResult PinVerification(string? pin, string? action)
{
    if (action == "reset")
    {
        HttpContext.Session.SetInt32("PinRemaining", 3);
        HttpContext.Session.SetInt32("PinLocked", 0);
        return View();
    }

    int remaining = HttpContext.Session.GetInt32("PinRemaining") ?? 3;

    if (pin == DEMO_PIN)
    {
        ViewBag.Message = "Access Granted! PIN verified successfully.";
        HttpContext.Session.SetInt32("PinRemaining", 3);
    }
    else
    {
        remaining--;
        HttpContext.Session.SetInt32("PinRemaining", remaining);
        if (remaining &lt;= 0)
        {
            HttpContext.Session.SetInt32("PinLocked", 1);
            ViewBag.Error = "Security Lockout Triggered! 3 failed attempts reached.";
        }
        else
        {
            ViewBag.Error = $"Incorrect PIN. {remaining} attempt(s) remaining.";
        }
    }
    return View();
}</code></pre>
        </div>
    </div>
    </div>
</details>

@section Scripts {
    <script>
        const pinInput = document.getElementById('pinInput');
        if (pinInput) {
            document.querySelectorAll('.keypad-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    if (pinInput.value.length < 4) {
                        pinInput.value += btn.getAttribute('data-val');
                    }
                });
            });

            const clearBtn = document.querySelector('.keypad-clear');
            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    pinInput.value = pinInput.value.slice(0, -1);
                });
            }
        }
    </script>
}
