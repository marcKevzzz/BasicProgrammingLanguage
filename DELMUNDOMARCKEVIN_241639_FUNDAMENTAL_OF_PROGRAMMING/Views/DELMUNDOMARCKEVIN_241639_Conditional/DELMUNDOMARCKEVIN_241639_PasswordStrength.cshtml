@model DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Models.DELMUNDOMARCKEVIN_241639_PasswordStrengthModel
@{
    ViewData["Title"] = "Password Strength Checker";
    var suggestions = Model.Suggestions as List<string>;
}

<!-- Header -->
<div class="mb-4">
    <h1 class="hero-title">Password Strength Checker</h1>
    <p class="hero-subtitle mb-0">Check password length and character types.</p>
</div>

<div class="row g-4 mb-5">
    <!-- Input Section -->
    <div class="col-12 col-lg-5">
        <div class="apple-card h-100">
            <div class="panel-heading d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-shield-lock fs-5 text-primary"></i>
                <h2 class="h5 fw-bold mb-0">Password Evaluation</h2>
            </div>

            <form method="post" asp-action="PasswordStrength" autocomplete="off">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="password" class="form-apple-label">Test Password <span class="text-danger">*</span></label>
                    <div class="password-field">
                        <input type="password"
                               id="password"
                               name="password"
                               class="form-apple-input"
                               placeholder="Enter a secret password..."
                               autocomplete="new-password"
                               required />
                        <button class="password-visibility" type="button" id="btnTogglePasswordVisibility" aria-label="Show password" aria-pressed="false" aria-controls="password">
                            <i class="bi bi-eye" id="eyeIcon" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="form-actions d-flex align-items-center gap-2 pt-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-cpu"></i> Analyze Strength
                    </button>
                    <a asp-action="PasswordStrength" asp-route-notice="reset" class="btn-apple-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Output Section -->
    <div class="col-12 col-lg-7">
        <div class="apple-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="panel-heading d-flex align-items-center gap-2 mb-3">
                    <h2 class="h5 fw-bold mb-0">Entropy &amp; Complexity Analysis</h2>
                </div>

                @if (Model.Error != null)
                {
                    <div class="alert alert-danger rounded-4 border-0 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i>
                        @Model.Error
                    </div>
                }
                else if (Model.Success == true)
                {
                    <div class="output-hero-panel">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-secondary small fw-bold text-uppercase">Security Classification</span>
                            <span class="badge @Model.BadgeClass px-3 py-1 rounded-pill fs-6 fw-semibold">
                                @Model.Rating
                            </span>
                        </div>

                        <!-- Progress Bar -->
                        <div class="progress mb-3" style="height: 10px; border-radius: 9999px;">
                            <div class="progress-bar @(Model.Score <= 2 ? "bg-danger" : Model.Score <= 4 ? "bg-warning" : "bg-success")"
                                 role="progressbar"
                                 style="width: @Model.ProgressPercent%"
                                 aria-valuenow="@Model.ProgressPercent"
                                 aria-valuemin="0"
                                 aria-valuemax="100"></div>
                        </div>

                        <!-- Criteria Checklist -->
                        <div class="row g-2 mb-3 small">
                            <div class="col-6">
                                <i class="bi @(Model.Length >= 8 ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") me-1"></i>
                                Minimum 8 Characters (@Model.Length chars)
                            </div>
                            <div class="col-6">
                                <i class="bi @(Model.HasUpper == true ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") me-1"></i>
                                Uppercase Letter (A-Z)
                            </div>
                            <div class="col-6">
                                <i class="bi @(Model.HasLower == true ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") me-1"></i>
                                Lowercase Letter (a-z)
                            </div>
                            <div class="col-6">
                                <i class="bi @(Model.HasDigit == true ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") me-1"></i>
                                Numeric Digit (0-9)
                            </div>
                            <div class="col-6">
                                <i class="bi @(Model.HasSpecial == true ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") me-1"></i>
                                Special Character (!@@#$%)
                            </div>
                        </div>

                        <!-- Recommendations -->
                        @if (suggestions != null && suggestions.Count > 0)
                        {
                            <div class="p-3 rounded-3 bg-light border small">
                                <strong class="d-block mb-1 text-dark"><i class="bi bi-lightbulb text-warning me-1"></i> Recommendations for Hardening:</strong>
                                <ul class="mb-0 ps-3 text-secondary">
                                    @foreach (var s in suggestions)
                                    {
                                        <li>@s</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="bi bi-key fs-1 mb-2 d-block opacity-50"></i>
                        <p class="mb-0">Type a test password on the left and click <strong>Analyze Strength</strong> to review complexity metrics.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content">
<div class="row g-4">
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Character Diversity Scorer</h6>
            <p class="text-secondary small">
                The controller inspects the string using character classifications (<code>char.IsUpper</code>, <code>char.IsLower</code>, <code>char.IsDigit</code>, and non-alphanumeric punctuation symbols). Each satisfied condition increments a cumulative score:
            </p>
            <div class="p-3 rounded-3 bg-light border font-monospace small">
                Score &le; 2 &rarr; Weak<br />
                Score 3 &ndash; 4 &rarr; Medium<br />
                Score &ge; 5 &rarr; Strong
            </div>
        </div>
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Security Best Practices</h6>
            <p class="text-secondary small">
                Modern passwords should favor phrase length and entropy over difficult-to-memorize substitutions. A 16-character passphrase composed of distinct dictionary words is substantially more resilient against brute-force attacks than an 8-character symbol scramble.
            </p>
        </div>
    </div>
    </div>
</details>

<!-- View C# Logic Section -->
<details class="lesson-details">
    <summary>C# code</summary>
    <div class="lesson-content">
<div class="lesson-body" id="passLogicPanel">
        <div class="macos-code-box">
            <div class="macos-code-header">
                <div class="traffic-dots">
                    <span class="dot dot-red"></span>
                    <span class="dot dot-yellow"></span>
                    <span class="dot dot-green"></span>
                </div>
                <div class="code-title">DELMUNDOMARCKEVIN_241639_ConditionalController.cs — PasswordStrength</div>
                <button type="button" class="btn-copy-code" data-code-target="passCode">
                    <i class="bi bi-clipboard"></i> Copy Code
                </button>
            </div>
            <pre class="macos-code-body" id="passCode"><code>[HttpPost]
[ValidateAntiForgeryToken]
public IActionResult PasswordStrength(string? password)
{
    if (string.IsNullOrEmpty(password))
    {
        Model.Error = "Please enter a password to evaluate.";
        return View();
    }

    int length = password.Length;
    bool hasUpper = password.Any(char.IsUpper);
    bool hasLower = password.Any(char.IsLower);
    bool hasDigit = password.Any(char.IsDigit);
    bool hasSpecial = password.Any(ch =&gt; !char.IsLetterOrDigit(ch));

    int score = 0;
    if (length &gt;= 8) score++;
    if (length &gt;= 12) score++;
    if (hasUpper &amp;&amp; hasLower) score++;
    if (hasDigit) score++;
    if (hasSpecial) score++;

    string rating;
    string badgeClass;
    int progressPercent;

    if (score &lt;= 2)
    {
        rating = "Weak";
        badgeClass = "bg-danger text-white";
        progressPercent = 25;
    }
    else
    {
        if (score == 3 || score == 4)
        {
            rating = "Medium";
            badgeClass = "bg-warning text-dark";
            progressPercent = 65;
        }
        else
        {
            rating = "Strong";
            badgeClass = "bg-success text-white";
            progressPercent = 100;
        }
    }

    var suggestions = new List&lt;string&gt;();
    if (length &lt; 12) suggestions.Add("Increase total length to at least 12-16 characters.");
    if (!hasUpper) suggestions.Add("Include at least one uppercase letter (A-Z).");
    if (!hasLower) suggestions.Add("Include at least one lowercase letter (a-z).");
    if (!hasDigit) suggestions.Add("Include at least one numeric digit (0-9).");
    if (!hasSpecial) suggestions.Add("Include at least one symbol or special character (!@@#$%^&amp;*).");

    if (suggestions.Count == 0)
    {
        suggestions.Add("Excellent! Your password fulfills all high-entropy security criteria.");
    }

    // Note: Never log or store the password. Pass only length and metrics to view.
    Model.Rating = rating;
    Model.BadgeClass = badgeClass;
    Model.Score = score;
    Model.Length = length;
    Model.HasUpper = hasUpper;
    Model.HasLower = hasLower;
    Model.HasDigit = hasDigit;
    Model.HasSpecial = hasSpecial;
    Model.ProgressPercent = progressPercent;
    Model.Suggestions = suggestions;
    Model.Success = true;

    return View();
}</code></pre>
        </div>
    </div>
    </div>
</details>

@section Scripts {
    <script>
        const btnToggle = document.getElementById('btnTogglePasswordVisibility');
        const passInput = document.getElementById('password');
        const eyeIcon = document.getElementById('eyeIcon');

        if (btnToggle && passInput && eyeIcon) {
            btnToggle.addEventListener('click', () => {
                if (passInput.type === 'password') {
                    passInput.type = 'text';
                    eyeIcon.className = 'bi bi-eye-slash';
                } else {
                    passInput.type = 'password';
                    eyeIcon.className = 'bi bi-eye';
                }
                const visible = passInput.type === 'text';
                btnToggle.setAttribute('aria-label', visible ? 'Hide password' : 'Show password');
                btnToggle.setAttribute('aria-pressed', String(visible));
            });
        }
    </script>
}
