@{
    ViewData["Title"] = "Scholarship Qualification";
    var criteria = ViewBag.Criteria as List<Dictionary<string, object>>;
}

<!-- Header -->
<div class="mb-4">
    <h1 class="hero-title">Scholarship Qualification</h1>
    <p class="hero-subtitle mb-0">Check eligibility using grades and household income.</p>
</div>

<div class="row g-4 mb-5">
    <!-- Input Section -->
    <div class="col-12 col-lg-5">
        <div class="apple-card h-100">
            <div class="panel-heading d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-person-vcard fs-5 text-primary"></i>
                <h2 class="h5 fw-bold mb-0">Applicant Data</h2>
            </div>

            <form method="post" asp-action="ScholarshipQualification">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="averageGrade" class="form-apple-label">General Weighted Average (GWA) <span class="text-danger">*</span></label>
                    <input type="number" 
                           id="averageGrade" 
                           name="averageGrade" 
                           value="@ViewBag.AverageGrade" 
                           min="0" 
                           max="100" 
                           step="0.1" 
                           class="form-apple-input" 
                           placeholder="e.g. 92.5" 
                           required />
                </div>

                <div class="mb-3">
                    <label for="householdIncome" class="form-apple-label">Monthly Household Income (₱) <span class="text-danger">*</span></label>
                    <input type="number" 
                           id="householdIncome" 
                           name="householdIncome" 
                           value="@ViewBag.HouseholdIncome" 
                           min="0" 
                           max="1000000" 
                           step="500" 
                           class="form-apple-input" 
                           placeholder="e.g. 20000" 
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-apple-label">Academic Standing Record</label>
                    <div class="form-check form-switch p-2 ps-5 rounded-3 bg-light border">
                        <input class="form-check-input ms-n5" 
                               type="checkbox" 
                               id="hasFailingGrades" 
                               name="hasFailingGrades" 
                               value="true" 
                               @(ViewBag.HasFailingGrades == true ? "checked" : "") />
                        <label class="form-check-label fw-medium text-dark small" for="hasFailingGrades">
                            Student has at least one failing grade (5.0 or &lt; 75)
                        </label>
                    </div>
                </div>

                <div class="form-actions d-flex align-items-center gap-2 pt-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-patch-check"></i> Evaluate Qualification
                    </button>
                    <a asp-action="ScholarshipQualification" asp-route-notice="reset" class="btn-apple-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Output Section -->
    <div class="col-12 col-lg-7">
        <div class="apple-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="panel-heading d-flex align-items-center gap-2 mb-3">
                    <h2 class="h5 fw-bold mb-0">Eligibility Determination</h2>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger rounded-4 border-0 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i>
                        @ViewBag.Error
                    </div>
                }
                else if (ViewBag.Success == true)
                {
                    bool isQualified = ViewBag.IsQualified == true;

                    <div class="output-hero-panel">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="text-secondary small fw-bold text-uppercase">Application Outcome</span>
                            <span class="apple-badge @(isQualified ? "badge-beginner" : "badge-advanced") fs-6 px-3 py-1">
                                <i class="bi @(isQualified ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                                @(isQualified ? "QUALIFIED" : "NOT QUALIFIED")
                            </span>
                        </div>

                        <p class="fw-semibold @(isQualified ? "text-success" : "text-danger") fs-5 mb-3">
                            @ViewBag.Explanation
                        </p>

                        @if (criteria != null)
                        {
                            <div class="list-group list-group-flush rounded-3 border">
                                @foreach (var c in criteria)
                                {
                                    bool passed = Convert.ToBoolean(c["passed"]);
                                    <div class="list-group-item bg-transparent d-flex align-items-center justify-content-between py-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi @(passed ? "bi-check2-circle text-success" : "bi-x-octagon text-danger") fs-5"></i>
                                            <span class="small fw-medium">@c["name"]</span>
                                        </div>
                                        <span class="badge @(passed ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded-pill px-2 py-1 small">
                                            @c["detail"]
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="bi bi-award fs-1 mb-2 d-block opacity-50"></i>
                        <p class="mb-0">Enter student grade, household income, and failing status to run qualification rules.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content">
<div class="row g-4">
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Boolean Conjunction Logic</h6>
            <p class="text-secondary small">
                All three criteria must evaluate to true simultaneously using the logical AND (<code>&amp;&amp;</code>) operator. If even a single condition fails, the candidate is disqualified:
            </p>
            <div class="p-3 rounded-3 bg-light border font-monospace small">
                IsQualified = (AverageGrade &ge; 90.0) &amp;&amp; <br />
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(HouseholdIncome &le; 25000.0) &amp;&amp; <br />
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(!hasFailingGrades);
            </div>
        </div>
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Sample Evaluation Matrix</h6>
            <div class="table-responsive">
                <table class="table table-sm table-bordered small">
                    <thead class="table-light">
                        <tr>
                            <th>Grade</th>
                            <th>Income</th>
                            <th>Fails</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>93.5</td>
                            <td>₱20,000</td>
                            <td>No</td>
                            <td><span class="text-success fw-bold">Qualified</span></td>
                        </tr>
                        <tr>
                            <td>88.0</td>
                            <td>₱18,000</td>
                            <td>No</td>
                            <td><span class="text-danger fw-bold">Not Qualified (Grade &lt; 90)</span></td>
                        </tr>
                        <tr>
                            <td>95.0</td>
                            <td>₱35,000</td>
                            <td>No</td>
                            <td><span class="text-danger fw-bold">Not Qualified (Income &gt; 25k)</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </div>
</details>

<!-- View C# Logic Section -->
<details class="lesson-details">
    <summary>C# code</summary>
    <div class="lesson-content">
<div class="lesson-body" id="scholarshipLogicPanel">
        <div class="macos-code-box">
            <div class="macos-code-header">
                <div class="traffic-dots">
                    <span class="dot dot-red"></span>
                    <span class="dot dot-yellow"></span>
                    <span class="dot dot-green"></span>
                </div>
                <div class="code-title">DELMUNDOMARCKEVIN_241639_ConditionalController.cs — ScholarshipQualification</div>
                <button type="button" class="btn-copy-code" data-code-target="scholarshipCode">
                    <i class="bi bi-clipboard"></i> Copy Code
                </button>
            </div>
            <pre class="macos-code-body" id="scholarshipCode"><code>[HttpPost]
[ValidateAntiForgeryToken]
public IActionResult ScholarshipQualification(double? averageGrade, double? householdIncome, bool hasFailingGrades)
{
    if (!averageGrade.HasValue || averageGrade.Value &lt; 0 || averageGrade.Value &gt; 100)
    {
        ViewBag.Error = "Please enter an average grade between 0 and 100.";
        return View();
    }

    if (!householdIncome.HasValue || householdIncome.Value &lt; 0)
    {
        ViewBag.Error = "Please enter a valid monthly household income.";
        return View();
    }

    double gpa = averageGrade.Value;
    double income = householdIncome.Value;

    bool gpaPassed = gpa &gt;= 90.0;
    bool incomePassed = income &lt;= 25000.0;
    bool noFailsPassed = !hasFailingGrades;

    bool isQualified = false;
    if (gpaPassed)
    {
        if (incomePassed)
        {
            if (noFailsPassed) isQualified = true;
        }
    }

    var criteria = new List&lt;Dictionary&lt;string, object&gt;&gt;
    {
        new() { ["name"] = "Academic Grade Requirement (≥ 90.0)", ["passed"] = gpaPassed, ["detail"] = $"Your Grade: {gpa:F1}" },
        new() { ["name"] = "Monthly Household Income Ceiling (≤ ₱25,000)", ["passed"] = incomePassed, ["detail"] = $"Your Income: ₱{income:N2}" },
        new() { ["name"] = "Clean Academic Record (No Failing Marks)", ["passed"] = noFailsPassed, ["detail"] = hasFailingGrades ? "Has failing marks reported" : "No failing marks" }
    };

    string explanation;
    if (isQualified)
    {
        explanation = "Congratulations! You meet all academic and financial requirements for the Merit &amp; Financial Assistance Scholarship Grant.";
    }
    else
    {
        var failedReasons = new List&lt;string&gt;();
        if (!gpaPassed) failedReasons.Add("Average grade is below the 90.0 threshold");
        if (!incomePassed) failedReasons.Add("Monthly household income exceeds the ₱25,000 maximum ceiling");
        if (!noFailsPassed) failedReasons.Add("Applicant has one or more failing marks");

        explanation = "Application was not qualified due to: " + string.Join("; ", failedReasons) + ".";
    }

    ViewBag.AverageGrade = gpa;
    ViewBag.HouseholdIncome = income;
    ViewBag.HasFailingGrades = hasFailingGrades;
    ViewBag.IsQualified = isQualified;
    ViewBag.Explanation = explanation;
    ViewBag.Criteria = criteria;
    ViewBag.Success = true;

    return View();
}</code></pre>
        </div>
    </div>
    </div>
</details>
