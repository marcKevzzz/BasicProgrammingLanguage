@model DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Models.DELMUNDOMARCKEVIN_241639_PayrollModel
@{ ViewData["Title"] = "Payroll Calculator"; }
<div class="mb-4"><h1 class="hero-title">Payroll Calculator</h1><p class="hero-subtitle">Calculate monthly take-home pay in pesos after employee contributions and graduated BIR withholding tax.</p></div>
<div class="row g-4 mb-5">
    <div class="col-12 col-lg-5"><div class="apple-card h-100 d-flex flex-column">
        <h2 class="h5 fw-bold mb-3"><i class="bi bi-cash-stack me-2" aria-hidden="true"></i>Monthly basic salary</h2>
        <form method="post" asp-action="Payroll" class="d-flex flex-column flex-grow-1">
            @Html.AntiForgeryToken()
            <label class="form-apple-label" for="salary">Basic salary (₱)</label>
            <input class="form-apple-input" id="salary" name="salary" type="number" inputmode="decimal" min="0.01" step="0.01" value="@Model.Salary" required aria-describedby="@(Model.Error != null ? "salary-help salary-error" : "salary-help")" aria-invalid="@(Model.Error != null ? "true" : "false")" />
            <p class="form-text" id="salary-help">Enter a positive amount with up to two decimal places.</p>
            @if (Model.Error != null) { <p class="text-danger" role="alert" id="salary-error">@Model.Error</p> }
            <div class="d-flex flex-wrap gap-2 mt-auto pt-4"><button class="btn-apple-primary" type="submit">Calculate payroll</button><a class="btn-apple-secondary" asp-action="Payroll" asp-route-notice="reset">Reset sample</a></div>
        </form>

    </div></div>
    <div class="col-12 col-lg-7"><div class="apple-card h-100">
        <h2 class="h5 fw-bold mb-3">Monthly payslip</h2>
        @if (Model.Result == null)
        { <div class="array-empty text-center text-secondary py-5"><i class="bi bi-receipt fs-1 d-block opacity-50 mb-3" aria-hidden="true"></i><p class="mb-0">Enter your basic salary and select <strong>Calculate payroll</strong> to see your contributions, taxable compensation, and net pay.</p></div> }
        else
        {
            <dl class="payroll-summary">
                <div><dt>Gross basic salary</dt><dd>₱@Model.Result!.Salary.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                <div><dt>SSS employee share <small class="d-block text-secondary">Salary credit: ₱@Model.Result!.SalaryCredit.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</small></dt><dd class="payroll-deduction">−₱@Model.Result!.Sss.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                <div><dt>PhilHealth employee share</dt><dd class="payroll-deduction">−₱@Model.Result!.PhilHealth.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                <div><dt>Pag-IBIG employee share</dt><dd class="payroll-deduction">−₱@Model.Result!.PagIbig.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                <div><dt>Total statutory contributions</dt><dd class="payroll-deduction">−₱@Model.Result!.Contributions.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                <div><dt>Taxable compensation</dt><dd>₱@Model.Result!.TaxableIncome.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                <div><dt>BIR withholding tax</dt><dd class="payroll-deduction">−₱@Model.Result!.WithholdingTax.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                <div><dt>Total deductions</dt><dd class="payroll-deduction">−₱@Model.Result!.TotalDeductions.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                <div class="payroll-net @(Model.Result!.NetPay < 0 ? "payroll-net-negative" : "")"><dt>Net take-home pay</dt><dd>₱@Model.Result!.NetPay.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
            </dl>
            @if (Model.Result!.NetPay < 0) { <p class="text-secondary">The minimum contribution bases exceed this salary, producing a negative balance in this simulation.</p> }
        }
    </div></div>
</div>
<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content">
        <ol>
            <li><strong>Use nested conditions:</strong> the outer salary check contains the centavo-precision check, and only its valid branch calculates contributions and tax; this is an actual <code>if</code> inside another <code>if</code>.</li><li><strong>Validate the input:</strong> <code>decimal.TryParse()</code> rejects invalid or overflowing numbers, and <code>if</code> rejects zero, negative amounts, and fractions smaller than one centavo.</li>
            <li><strong>Find SSS salary credit:</strong> the 2025 employee schedule uses ₱500 credit steps, a ₱5,000 floor, and a ₱35,000 cap; the employee pays 5% of that credit, including the mandatory provident-fund share.</li>
            <li><strong>Apply contribution limits:</strong> PhilHealth uses 5% of salary clamped to ₱10,000–₱100,000, divided equally with the employer; Pag-IBIG uses 1% at salaries up to ₱1,500 and 2% above, with a ₱10,000 compensation cap.</li>
            <li><strong>Derive taxable compensation:</strong> subtract the three rounded employee contributions from basic salary, with a minimum taxable amount of zero.</li>
            <li><strong>Select one tax bracket:</strong> the <code>if / else if</code> ladder applies the fixed tax plus the marginal rate only to the excess over the bracket threshold.</li>
            <li><strong>Calculate net pay:</strong> subtract contributions and withholding tax from gross salary; amounts round to centavos with midpoint values rounded away from zero.</li>
        </ol>
        <div class="table-responsive"><table class="apple-table"><caption>BIR monthly withholding table, effective January 2023 onwards</caption><thead><tr><th>Taxable compensation</th><th>Fixed tax</th><th>Tax on excess</th></tr></thead><tbody>
            <tr><td>₱20,833 and below</td><td>₱0.00</td><td>Exempt</td></tr>
            <tr><td>Above ₱20,833 to below ₱33,333</td><td>₱0.00</td><td>15% over ₱20,833</td></tr>
            <tr><td>₱33,333 to below ₱66,667</td><td>₱1,875.00</td><td>20% over ₱33,333</td></tr>
            <tr><td>₱66,667 to below ₱166,667</td><td>₱8,541.80</td><td>25% over ₱66,667</td></tr>
            <tr><td>₱166,667 to below ₱666,667</td><td>₱33,541.80</td><td>30% over ₱166,667</td></tr>
            <tr><td>₱666,667 and above</td><td>₱183,541.80</td><td>35% over ₱666,667</td></tr>
        </tbody></table></div>
        <p>Example: ₱30,000.00 basic salary − ₱1,500.00 SSS − ₱750.00 PhilHealth − ₱200.00 Pag-IBIG = ₱27,550.00 taxable compensation; tax is ₱1,007.55 and net pay is ₱26,542.45.</p>
        <p class="form-text">Schedule references checked 1 November 2026: <a href="https://www.sss.gov.ph/wp-content/uploads/2024/12/2025-SSS-Contribution-Table-rev.pdf">SSS employee schedule</a>, <a href="https://www.philhealth.gov.ph/advisories/2025/PA2025-0002.pdf">PhilHealth premium advisory</a>, <a href="https://pia.gov.ph/news/philhealth-sets-5-premium-contribution-rate-for-2026/">PhilHealth 2026 confirmation</a>, <a href="https://adminmanual.upd.edu.ph/edition/active/chapter/e-1-pag-ibig-civilian-annex-e">Pag-IBIG Circular 460 rates</a>, and <a href="https://bir-cdn.bir.gov.ph/local/pdf/Annex%20E%20RR%2011-2018.pdf">BIR Annex E under TRAIN (RA 10963)</a>.</p>


    </div>
</details>
<details class="lesson-details">
    <summary>C# code</summary>
    <div class="lesson-content">
        <div class="macos-code-box">
            <div class="macos-code-header"><div class="code-title">ConditionalController.cs — salary validation</div><button type="button" class="btn-copy-code" data-code-target="PayrollValidationCode">Copy code</button></div>
            <pre class="macos-code-body" id="PayrollValidationCode"><code>[HttpPost]
        [ValidateAntiForgeryToken]
        public IActionResult Payroll(string? salary)
        {
            Model.Salary = salary;
            if (!decimal.TryParse(salary, System.Globalization.NumberStyles.AllowDecimalPoint |
                System.Globalization.NumberStyles.AllowLeadingSign | System.Globalization.NumberStyles.AllowLeadingWhite |
                System.Globalization.NumberStyles.AllowTrailingWhite, System.Globalization.CultureInfo.InvariantCulture,
                out decimal basicSalary) || basicSalary &lt;= 0 || basicSalary != Services.PayrollCalculator.Money(basicSalary))
            {
                Model.Error = "Enter a positive monthly salary with up to two decimal places, such as 30000.00.";
                return View();
            }
            return View(Services.PayrollCalculator.Calculate(basicSalary));
        }</code></pre>
        </div>


        <div class="macos-code-box">
            <div class="macos-code-header"><div class="code-title">PayrollCalculator.cs — contributions and tax brackets</div><button type="button" class="btn-copy-code" data-code-target="PayrollCode">Copy code</button></div>
            <pre class="macos-code-body" id="PayrollCode"><code>namespace DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Services;

public sealed record PayrollBreakdown(decimal Salary, decimal SalaryCredit, decimal Sss,
    decimal PhilHealth, decimal PagIbig, decimal TaxableIncome, decimal WithholdingTax)
{
    public decimal Contributions =&gt; Sss + PhilHealth + PagIbig;
    public decimal TotalDeductions =&gt; Contributions + WithholdingTax;
    public decimal NetPay =&gt; Salary - TotalDeductions;
}

public static class PayrollCalculator
{
    public static decimal Money(decimal value) =&gt; decimal.Round(value, 2, MidpointRounding.AwayFromZero);

    // SSS employee schedule effective January 2025; PhilHealth 5%; HDMF Circular 460.
    public static PayrollBreakdown Calculate(decimal salary)
    {
        if (salary &gt; 0)
        {
            if (salary == Money(salary))
            {
                decimal credit = Math.Clamp(decimal.Floor((Math.Min(salary, 35000m) + 250m) / 500m) * 500m, 5000m, 35000m);
                decimal sss = Money(credit * 0.05m);
                decimal philHealth = Money(Math.Clamp(salary, 10000m, 100000m) * 0.05m / 2m);
                decimal pagIbigRate;
                if (salary &lt;= 1500m) pagIbigRate = 0.01m;
                else pagIbigRate = 0.02m;
                decimal pagIbig = Money(Math.Min(salary, 10000m) * pagIbigRate);
                decimal taxable = Math.Max(0m, salary - sss - philHealth - pagIbig);
                return new(salary, credit, sss, philHealth, pagIbig, taxable, MonthlyTax(taxable));
            }
            else throw new ArgumentException("Salary must use whole centavos.", nameof(salary));
        }
        else throw new ArgumentOutOfRangeException(nameof(salary));
    }

    // BIR RR 11-2018 Annex E: monthly table effective January 2023 onwards.
    public static decimal MonthlyTax(decimal taxable)
    {
        decimal tax;
        if (taxable &lt;= 20833m) tax = 0m;
        else if (taxable &lt; 33333m) tax = (taxable - 20833m) * 0.15m;
        else if (taxable &lt; 66667m) tax = 1875m + (taxable - 33333m) * 0.20m;
        else if (taxable &lt; 166667m) tax = 8541.80m + (taxable - 66667m) * 0.25m;
        else if (taxable &lt; 666667m) tax = 33541.80m + (taxable - 166667m) * 0.30m;
        else tax = 183541.80m + (taxable - 666667m) * 0.35m;
        return Money(tax);
    }
}
</code></pre>
