@{
    ViewData["Title"] = "Outfit Recommendation";
}

<!-- Header -->
<div class="mb-4">
    <h1 class="hero-title">Outfit Recommendation</h1>
    <p class="hero-subtitle mb-0">Choose an outfit based on temperature and weather.</p>
</div>

<div class="row g-4 mb-5">
    <!-- Input Section -->
    <div class="col-12 col-lg-5">
        <div class="apple-card h-100">
            <div class="panel-heading d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-thermometer-half fs-5 text-primary"></i>
                <h2 class="h5 fw-bold mb-0">Weather Parameters</h2>
            </div>

            <form method="post" asp-action="OutfitRecommendation">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="temperature" class="form-apple-label">Temperature (&deg;C) <span class="text-danger">*</span></label>
                    <input type="number" 
                           id="temperature" 
                           name="temperature" 
                           value="@ViewBag.Temperature" 
                           min="-40" 
                           max="60" 
                           step="0.5" 
                           class="form-apple-input" 
                           placeholder="e.g. 24.5" 
                           required />
                </div>

                <div class="mb-3">
                    <label for="weatherCondition" class="form-apple-label">Weather Condition <span class="text-danger">*</span></label>
                    <select id="weatherCondition" name="weatherCondition" class="form-apple-select" required>
                        <option value="Sunny" selected="@(ViewBag.WeatherCondition == "Sunny")">☀️ Sunny / Clear Sky</option>
                        <option value="Rainy" selected="@(ViewBag.WeatherCondition == "Rainy")">🌧️ Rainy / Wet Downpour</option>
                        <option value="Windy" selected="@(ViewBag.WeatherCondition == "Windy")">💨 Windy / Gusty</option>
                        <option value="Cloudy" selected="@(ViewBag.WeatherCondition == "Cloudy")">☁️ Overcast / Cloudy</option>
                        <option value="Snowy" selected="@(ViewBag.WeatherCondition == "Snowy")">❄️ Snowy / Frost</option>
                    </select>
                </div>

                <div class="form-actions d-flex align-items-center gap-2 pt-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-sparkles"></i> Get Recommendation
                    </button>
                    <a asp-action="OutfitRecommendation" asp-route-notice="reset" class="btn-apple-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Output Section -->
    <div class="col-12 col-lg-7">
        <div class="apple-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="panel-heading d-flex align-items-center gap-2 mb-3">
                    <h2 class="h5 fw-bold mb-0">Recommended Wardrobe</h2>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger rounded-4 border-0 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i>
                        @ViewBag.Error
                    </div>
                }
                else if (ViewBag.Success == true)
                {
                    <div class="output-hero-panel">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <span class="text-secondary small fw-bold text-uppercase">Thermal Profile</span>
                                <div class="h4 fw-bold text-primary mb-0">@ViewBag.Category</div>
                            </div>
                            <span class="apple-badge badge-intermediate fs-6">
                                @ViewBag.Temperature&deg;C &bull; @ViewBag.WeatherCondition
                            </span>
                        </div>

                        <div class="list-group list-group-flush rounded-3 border">
                            <div class="list-group-item bg-transparent d-flex align-items-start gap-3 py-2">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <div>
                                    <strong class="d-block text-secondary small text-uppercase">Upper Body &amp; Outerwear</strong>
                                    <span>@ViewBag.Top</span>
                                </div>
                            </div>
                            <div class="list-group-item bg-transparent d-flex align-items-start gap-3 py-2">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <div>
                                    <strong class="d-block text-secondary small text-uppercase">Pants / Lower Body</strong>
                                    <span>@ViewBag.Bottom</span>
                                </div>
                            </div>
                            <div class="list-group-item bg-transparent d-flex align-items-start gap-3 py-2">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <div>
                                    <strong class="d-block text-secondary small text-uppercase">Footwear</strong>
                                    <span>@ViewBag.Footwear</span>
                                </div>
                            </div>
                            <div class="list-group-item bg-transparent d-flex align-items-start gap-3 py-2">
                                <i class="bi bi-shield-check text-primary fs-5"></i>
                                <div>
                                    <strong class="d-block text-secondary small text-uppercase">Essential Gear &amp; Accessories</strong>
                                    <span>@ViewBag.Accessories</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="bi bi-cloud-sun fs-1 mb-2 d-block opacity-50"></i>
                        <p class="mb-0">Choose temperature and weather condition, then click <strong>Get Recommendation</strong>.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content">
<div class="row g-4">
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Decision Tree Architecture</h6>
            <p class="text-secondary small">
                The controller executes a dual-layer conditional decision process:
            </p>
            <ol class="text-secondary small ps-3">
                <li><strong>Temperature Ladder (if/else-if):</strong> Segregates thermal comfort into Freezing (&lt;10&deg;C), Cool (10-19&deg;C), Mild (20-28&deg;C), and Hot (&gt;28&deg;C).</li>
                <li><strong>Weather Modifier (switch):</strong> Appends functional gear (umbrellas, sunglasses, windbreakers) depending on precipitation and wind.</li>
            </ol>
        </div>
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Sample Branches</h6>
            <div class="table-responsive">
                <table class="table table-sm table-bordered small">
                    <thead class="table-light">
                        <tr>
                            <th>Condition</th>
                            <th>Decision Branch</th>
                            <th>Key Gear</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>31&deg;C &bull; Sunny</td>
                            <td>Hot &amp; Tropical</td>
                            <td>Linen shirt, shorts, sunglasses, sunscreen</td>
                        </tr>
                        <tr>
                            <td>16&deg;C &bull; Rainy</td>
                            <td>Cool / Chilly</td>
                            <td>Hoodie/jacket, umbrella, waterproof sneakers</td>
                        </tr>
                        <tr>
                            <td>5&deg;C &bull; Snowy</td>
                            <td>Freezing</td>
                            <td>Thermal parka, boots, beanie, gloves</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </div>
</details>

<!-- View C# Logic Section -->
<details class="lesson-details">
    <summary>C# code</summary>
    <div class="lesson-content">
<div class="lesson-body" id="outfitLogicPanel">
        <div class="macos-code-box">
            <div class="macos-code-header">
                <div class="traffic-dots">
                    <span class="dot dot-red"></span>
                    <span class="dot dot-yellow"></span>
                    <span class="dot dot-green"></span>
                </div>
                <div class="code-title">DELMUNDOMARCKEVIN_241639_ConditionalController.cs — OutfitRecommendation</div>
                <button type="button" class="btn-copy-code" data-code-target="outfitCode">
                    <i class="bi bi-clipboard"></i> Copy Code
                </button>
            </div>
            <pre class="macos-code-body" id="outfitCode"><code>[HttpPost]
[ValidateAntiForgeryToken]
public IActionResult OutfitRecommendation(double? temperature, string? weatherCondition)
{
    if (!temperature.HasValue)
    {
        ViewBag.Error = "Please enter the ambient temperature.";
        return View();
    }

    if (string.IsNullOrWhiteSpace(weatherCondition))
    {
        ViewBag.Error = "Please select the current weather condition.";
        return View();
    }

    double temp = temperature.Value;
    string weather = weatherCondition.Trim();
    string category;
    string top;
    string bottom;
    string accessories;
    string footwear;

    // Temperature conditional ladder
    if (temp &lt; 10)
    {
        category = "Freezing / Very Cold";
        top = "Thermal undershirt, heavy wool sweater, and a thick insulated parka coat";
        bottom = "Fleece-lined denim or heavy trousers";
        footwear = "Insulated winter boots with thick thermal socks";
    }
    else
    {
        if (temp &gt;= 10 &amp;&amp; temp &lt; 20)
        {
            category = "Cool / Chilly";
            top = "Long-sleeve shirt paired with a cozy cardigan, hoodie, or denim jacket";
            bottom = "Comfortable chinos or classic jeans";
            footwear = "Leather sneakers or ankle boots";
        }
        else
        {
            if (temp &gt;= 20 &amp;&amp; temp &lt;= 28)
            {
                category = "Mild &amp; Pleasant";
                top = "Breathable cotton t-shirt or light button-down polo";
                bottom = "Lightweight trousers, culottes, or relaxed jeans";
                footwear = "Everyday canvas sneakers or loafers";
            }
            else
            {
                category = "Hot &amp; Tropical";
                top = "Ultra-lightweight linen shirt or moisture-wicking sleeveless top";
                bottom = "Cotton shorts or loose airy linen pants";
                footwear = "Breathable slip-on shoes or comfortable sandals";
            }
        }
    }

    // Weather accessory modifiers using switch statement
    switch (weather.ToLowerInvariant())
    {
        case "rainy":
        accessories = "Carry a sturdy umbrella, waterproof windbreaker, and keep valuables in a water-resistant backpack.";
        footwear += " (waterproof / quick-drying)";
        break;
        case "windy":
        accessories = "Add a wind-resistant shell jacket or scarf to block brisk gusts.";
        break;
        case "snowy":
        accessories = "Wear a warm beanie, thermal gloves, and an insulated neck gaiter.";
        break;
        case "sunny":
        accessories = "UV-blocking sunglasses, broad-spectrum sunscreen (SPF 50+), and a wide-brim hat or cap.";
        break;
        case "cloudy":
        default:
        accessories = "A light packable layer in case the sky turns overcast or breezy.";
        break;
    }

    ViewBag.Temperature = temp;
    ViewBag.WeatherCondition = weather;
    ViewBag.Category = category;
    ViewBag.Top = top;
    ViewBag.Bottom = bottom;
    ViewBag.Footwear = footwear;
    ViewBag.Accessories = accessories;
    ViewBag.Success = true;

    return View();
}</code></pre>
        </div>
    </div>
    </div>
</details>
