@inject DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Services.ProgramCatalog Catalog
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var toastMessage = TempData["Success"]?.ToString();
    if (Context.Request.Method == "POST")
        toastMessage ??= (ViewData.Model as DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Models.DELMUNDOMARCKEVIN_241639_IPageFeedback)?.Error ?? (ViewData.Model as DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Models.DELMUNDOMARCKEVIN_241639_IPageFeedback)?.Message ?? ViewBag.Error as string ?? ViewBag.Message as string ?? "Calculation complete.";
    if (Context.Request.Query["notice"] == "reset") toastMessage = "Form reset.";
    var activeProgram = Catalog.Programs.FirstOrDefault(program => program.Controller.ToString() == currentController &&
        (program.Action.ToString() == currentAction || program.CategoryId.ToString() == "crud"));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@(ViewData["Title"]?.ToString() == "FUNDAMENTAL OF PROGRAMMING" ? "FUNDAMENTAL OF PROGRAMMING" : $"{ViewData["Title"]} - FUNDAMENTAL OF PROGRAMMING")</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="preload" href="~/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
        <div class="header-inner">
            <a asp-controller="DELMUNDOMARCKEVIN_241639_Home" asp-action="Index" class="site-brand" aria-label="FUNDAMENTAL OF PROGRAMMING home">
                <span class="brand-mark" aria-hidden="true"><i class="bi bi-code-slash"></i></span>
                <span>FUNDAMENTAL OF<span class="brand-second-line"> PROGRAMMING</span></span>
            </a>
            <div class="header-actions">
            <button class="search-trigger" type="button" aria-label="Search programs" aria-haspopup="dialog" aria-controls="program-search-dialog">
                <i class="bi bi-search" aria-hidden="true"></i>
                <span>Search programs...</span><kbd>Ctrl K</kbd>
            </button>
                <button type="button" class="theme-toggle-btn icon-button" aria-label="Switch to dark theme" title="Switch theme">
                    <svg class="theme-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="theme-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.7 13A8.7 8.7 0 0 1 11 3.3 8.7 8.7 0 1 0 20.7 13Z" /></svg>
                </button>
                <button class="mobile-menu-toggle icon-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="app-sidebar"><i class="bi bi-list" aria-hidden="true"></i></button>
            </div>
        </div>
    </header>
    <div class="docs-layout">
        <div class="sidebar-backdrop" hidden></div>
        <aside class="app-sidebar" id="app-sidebar" aria-label="Program navigation">
            <div class="sidebar-mobile-heading"><span>Programs</span><button type="button" class="sidebar-close icon-button" aria-label="Close navigation"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <nav aria-label="Programs">
                <a asp-controller="DELMUNDOMARCKEVIN_241639_Home" asp-action="Index" class="sidebar-overview @(currentController == "DELMUNDOMARCKEVIN_241639_Home" ? "active" : "")" aria-current="@(currentController == "DELMUNDOMARCKEVIN_241639_Home" ? "page" : null)"><i class="bi bi-grid" aria-hidden="true"></i> All programs</a>
                @foreach (var category in Catalog.Categories)
                {
                    var categoryId = category.Id.ToString();
                    var categoryPrograms = Catalog.Programs.Where(program => program.CategoryId.ToString() == categoryId).ToList();
                    <details class="nav-group @(activeProgram?.CategoryId.ToString() == categoryId ? "category-active" : "")" data-category="@categoryId">
                        <summary><span><i class="bi @category.Icon" aria-hidden="true"></i>@category.Name</span><i class="bi bi-chevron-right" aria-hidden="true"></i></summary>
                        <ul>
                            @foreach (var program in categoryPrograms)
                            {
                                var isActive = ReferenceEquals(program, activeProgram);
                                <li><a asp-controller="@program.Controller" asp-action="@program.Action" class="@(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)">@program.Title</a></li>
                            }
                        </ul>
                    </details>
                }
            </nav>
            <a class="sidebar-github" href="https://github.com/marcKevzzz" target="_blank" rel="noopener noreferrer"><i class="bi bi-github" aria-hidden="true"></i><span>marcKevzzz</span><i class="bi bi-arrow-up-right program-arrow" aria-hidden="true"></i></a>
        </aside>
        <div class="app-main">
            <main class="app-content" id="main-content" tabindex="-1">
                @if (currentController != "DELMUNDOMARCKEVIN_241639_Home")
                {
                    <nav class="page-breadcrumb" aria-label="Breadcrumb"><a asp-controller="DELMUNDOMARCKEVIN_241639_Home" asp-action="Index">Programs</a><i class="bi bi-chevron-right" aria-hidden="true"></i>@if (activeProgram != null)
                        {
                            <a asp-controller="DELMUNDOMARCKEVIN_241639_Home" asp-action="Index" asp-route-category="@activeProgram.CategoryId">@activeProgram.Category</a>
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            @if (currentAction != activeProgram.Action.ToString())
                            {
                                <a asp-controller="@activeProgram.Controller" asp-action="@activeProgram.Action">@activeProgram.Title</a>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                <span aria-current="page">@(currentAction == "Create" ? "Add" : currentAction)</span>
                            }
                            else
                            {
                                <span aria-current="page">@activeProgram.Title</span>
                            }
                        }
                        else
                        {
                            <span aria-current="page">@ViewData["Title"]</span>
                        }</nav>
                }
                <div class="app-toast" id="app-toast" role="status" aria-live="polite" aria-atomic="true" hidden="@(string.IsNullOrEmpty(toastMessage))">@toastMessage</div>
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <dialog id="program-search-dialog" class="search-dialog" aria-labelledby="search-title">
        <form method="dialog" class="search-dialog-header">
            <i class="bi bi-search" aria-hidden="true"></i>
            <label id="search-title" class="visually-hidden" for="globalProgramSearch">Search all programs</label>
            <input id="globalProgramSearch" type="search" placeholder="Search programs..." autocomplete="off" autofocus />
            <button type="submit" class="search-close" aria-label="Close search">Esc</button>
        </form>
        <div class="search-results" aria-label="Search results">
            @foreach (var program in Catalog.Programs)
            {
                <a class="search-result" asp-controller="@program.Controller" asp-action="@program.Action" data-search="@program.Title @program.Desc @program.Category">
                    <i class="bi @program.Icon" aria-hidden="true"></i><span><strong>@program.Title</strong><small>@program.Category</small></span><i class="bi bi-arrow-return-left" aria-hidden="true"></i>
                </a>
            }
            <p id="search-empty" hidden>No programs found. Try another word.</p>
        </div>
        <div class="search-dialog-footer"><span id="search-result-count" role="status">@Catalog.Programs.Count programs</span><span>↑ ↓ to navigate · Enter to open</span></div>
    </dialog>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
