<h1 class="hero-title">General Weighted Average</h1>
<p class="text-secondary">Enter subject grades in a one-dimensional array to calculate their equal-weight average, numerical grade, and pass-or-fail result.</p>
<partial name="DELMUNDOMARCKEVIN_241639_ArrayForm" model="Model" />

<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content"><p>Add all grades, then divide by the number of grades. Each entry has equal weight. For example, 90 and 80 give (90 + 80) ÷ 2 = 85.</p><p>The weighted percentage is rounded to two decimal places before conversion.</p><div class="table-responsive"><table class="apple-table"><thead><tr><th>Percentage</th><th>Grade</th><th>Rating</th><th>Remarks</th></tr></thead><tbody><tr><td>96.50–100</td><td>1.00</td><td>Excellent</td><td>Passed</td></tr><tr><td>92.50–96.49</td><td>1.25</td><td>Very Good</td><td>Passed</td></tr><tr><td>88.50–92.49</td><td>1.50</td><td>Very Good</td><td>Passed</td></tr><tr><td>84.50–88.49</td><td>1.75</td><td>Good</td><td>Passed</td></tr><tr><td>80.50–84.49</td><td>2.00</td><td>Good</td><td>Passed</td></tr><tr><td>76.50–80.49</td><td>2.25</td><td>Satisfactory</td><td>Passed</td></tr><tr><td>72.50–76.49</td><td>2.50</td><td>Satisfactory</td><td>Passed</td></tr><tr><td>68.50–72.49</td><td>2.75</td><td>Fair</td><td>Passed</td></tr><tr><td>64.50–68.49</td><td>3.00</td><td>Fair</td><td>Passed</td></tr><tr><td>Below 64.50</td><td>5.00</td><td>Poor / Failed</td><td>Failed</td></tr></tbody></table></div></div>
</details>
<details class="lesson-details">
    <summary>C# code</summary>
    <div class="lesson-content">
        <div class="macos-code-box">
            <div class="macos-code-header">
                <div class="code-title">ArrayCalculations.cs — SumAverage</div>
                <button type="button" class="btn-copy-code" data-code-target="SumAverageCode">Copy code</button>
            </div>
            <pre class="macos-code-body" id="SumAverageCode"><code>using System.Globalization;
namespace DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Services;

public static class ArrayCalculations
{
    public static bool TryNumbers(string? input, out decimal[] values)
    {
        values = [];
        if (string.IsNullOrWhiteSpace(input) || input.Length &gt; 3000) return false;
        var tokens = input.Split(new[] { ',', ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
        if (tokens.Length is &lt; 1 or &gt; 100) return false;
        values = new decimal[tokens.Length];
        for (int i = 0; i &lt; tokens.Length; i++)
            if (!decimal.TryParse(tokens[i], NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint,
                CultureInfo.InvariantCulture, out values[i]) || values[i] &lt; -1000000 || values[i] &gt; 1000000) return false;
        return true;
    }


    public static (string Result, bool Passed) GradeAverage(decimal[] values)
    {
        decimal total = 0;
        for (int i = 0; i &lt; values.Length; i++) total += values[i];
        decimal average = total / values.Length;
        average = Math.Round(average, 2, MidpointRounding.AwayFromZero);
        var equivalent = average switch
        {
            &gt;= 96.50m =&gt; (1.00m, "Excellent"),
            &gt;= 92.50m =&gt; (1.25m, "Very Good"),
            &gt;= 88.50m =&gt; (1.50m, "Very Good"),
            &gt;= 84.50m =&gt; (1.75m, "Good"),
            &gt;= 80.50m =&gt; (2.00m, "Good"),
            &gt;= 76.50m =&gt; (2.25m, "Satisfactory"),
            &gt;= 72.50m =&gt; (2.50m, "Satisfactory"),
            &gt;= 68.50m =&gt; (2.75m, "Fair"),
            &gt;= 64.50m =&gt; (3.00m, "Fair"),
            _ =&gt; (5.00m, "Poor / Failed")
        };
        string remarks = average &gt;= 64.50m ? "Passed" : "Failed";
        string result = FormattableString.Invariant($"General weighted average: {average:0.00}%\nNumerical grade: {equivalent.Item1:0.00}\nDescriptive rating: {equivalent.Item2}\nRemarks: {remarks}");
        return (result, average &gt;= 64.50m);
    }

    public static string BubbleSort(decimal[] input, string direction)
    {
        var values = (decimal[])input.Clone();
        for (int pass = 0; pass &lt; values.Length - 1; pass++)
        {
            for (int i = 0; i &lt; values.Length - 1 - pass; i++)
            {
                if (direction == "ascending" ? values[i] &gt; values[i + 1] : values[i] &lt; values[i + 1])
                {
                    decimal temporary = values[i];
                    values[i] = values[i + 1];
                    values[i + 1] = temporary;
                }
            }
        }
        return (direction == "descending" ? "Descending: " : "Ascending: ") +
            string.Join(", ", values.Select(value =&gt; value.ToString(CultureInfo.InvariantCulture)));
    }
}
