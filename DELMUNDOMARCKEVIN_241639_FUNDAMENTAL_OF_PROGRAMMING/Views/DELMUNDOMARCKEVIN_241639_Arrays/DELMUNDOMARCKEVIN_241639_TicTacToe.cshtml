@model DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Models.DELMUNDOMARCKEVIN_241639_TicTacToeModel
@{ ViewData["Title"] = "Tic-Tac-Toe"; char[,] board = Model.Board; int[] winning = Model.Winning; bool finished = Model.Finished; string status = winning.Length > 0 ? $"{board[winning[0] / 3, winning[0] % 3]} wins!" : finished ? "Draw. Start a new game." : $"{Model.Turn}’s turn"; }
<div class="mb-4"><h1 class="hero-title">Tic-Tac-Toe</h1><p class="hero-subtitle">Two players take turns choosing an empty cell in a 3 × 3 board, with X playing first.</p></div>
<div class="apple-card mb-5" data-array-program="game">
    <p role="status" aria-live="polite" class="h5 mb-3" data-grid-status>@(Model.Message ?? status)</p>
    <div class="tic-grid">
    @for (int r = 0; r < 3; r++) { for (int c = 0; c < 3; c++) { char value = board[r, c]; int index = r * 3 + c;
        <form method="post" asp-action="TicTacToe"><input type="hidden" name="command" value="move" /><input type="hidden" name="row" value="@r" /><input type="hidden" name="column" value="@c" /><button class="tic-cell @(winning.Contains(index) ? "tic-winning" : "")" data-cell="@index" aria-label="Row @(r + 1), column @(c + 1): @(value == '.' ? "empty" : value.ToString())" disabled="@(finished || value != '.')">@(value == '.' ? "" : value.ToString())</button></form>
    } }
    @if (winning.Length > 0) { int first = winning[0], last = winning[2]; <svg class="tic-win-line" viewBox="0 0 300 300" aria-hidden="true"><line x1="@(50 + first % 3 * 100)" y1="@(50 + first / 3 * 100)" x2="@(50 + last % 3 * 100)" y2="@(50 + last / 3 * 100)" /></svg> }
    </div>
    <form method="post" asp-action="TicTacToe" class="mt-3"><button name="command" value="reset" class="btn-apple-secondary">New game</button></form>
</div>
<details class="lesson-details"><summary>How it works</summary><div class="lesson-content"><ol><li>A C# <code>char[3, 3]</code> stores X, O, or a dot for an empty cell.</li><li>A valid move puts the current symbol at <code>board[row, column]</code>.</li><li>C# checks three rows, three columns, and two diagonals for three matching non-empty values.</li><li>A winning line ends the game; a full board without a winner is a draw, otherwise the turn changes.</li></ol></div></details>
<details class="lesson-details"><summary>C# code</summary><div class="lesson-content"><p>These are the actual C# methods used by this exercise; the controller calls them and remembers your state in a session.</p><div class="macos-code-box"><div class="macos-code-header"><div class="code-title">GridExercises.cs — actual 2D array logic</div><button type="button" class="btn-copy-code" data-code-target="TicTacToeCode">Copy code</button></div><pre class="macos-code-body" id="TicTacToeCode"><code>    public static char[,] GameBoard(string state)
    {
        <mark class="array-code-highlight">char[,] board = new char[3, 3];</mark>
        for (int row = 0; row &lt; 3; row++)
            for (int column = 0; column &lt; 3; column++)
                board[row, column] = state[row * 3 + column];
        return board;
    }

    public static int[] WinningCells(char[,] board)
    {
        for (int i = 0; i &lt; 3; i++)
        {
            if (board[i, 0] != '.' &amp;&amp; board[i, 0] == board[i, 1] &amp;&amp; board[i, 1] == board[i, 2]) return [i * 3, i * 3 + 1, i * 3 + 2];
            if (board[0, i] != '.' &amp;&amp; board[0, i] == board[1, i] &amp;&amp; board[1, i] == board[2, i]) return [i, i + 3, i + 6];
        }
        if (board[1, 1] != '.')
        {
            if (board[0, 0] == board[1, 1] &amp;&amp; board[1, 1] == board[2, 2]) return [0, 4, 8];
            if (board[0, 2] == board[1, 1] &amp;&amp; board[1, 1] == board[2, 0]) return [2, 4, 6];
        }
        return [];
    }

    public static string SaveBoard(char[,] board)
    {
        string state = "";
        for (int row = 0; row &lt; board.GetLength(0); row++)
            for (int column = 0; column &lt; board.GetLength(1); column++) state += board[row, column];
        return state;
    }</code></pre></div></div></details>
