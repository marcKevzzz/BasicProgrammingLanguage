@model DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Models.DELMUNDOMARCKEVIN_241639_HomeIndexModel
@{
    ViewData["Title"] = "FUNDAMENTAL OF PROGRAMMING";
    var categories = Model.Categories;
    var programs = Model.Programs;
}

<header class="catalog-heading">
    <p class="catalog-context">Programs</p>
    <h1 class="hero-title">FUNDAMENTAL OF PROGRAMMING</h1>
    <p class="hero-subtitle">@programs.Count small C# programs for practicing basic input-output, nested if/else, loops, arrays, and CRUD.</p>
    <pre class="catalog-quickstart" aria-label="Create and run a C# console project"><code>dotnet new console -n Practice
dotnet run --project Practice</code></pre>
</header>

<section aria-label="Find a program" class="catalog-controls">
    <div class="catalog-filters" role="group" aria-label="Program category; swipe sideways for more categories">
        <button type="button" class="filter-pill active" data-filter="all" aria-pressed="true">All <span>@programs.Count</span></button>
        @foreach (var cat in categories)
        {
            <button type="button" class="filter-pill" data-filter="@cat.Id" aria-pressed="false">@cat.Name <span>@cat.Count</span></button>
        }
    </div>
    <span id="programCount" role="status">@programs.Count programs</span>
</section>

<section aria-labelledby="programs-heading">
    <h2 id="programs-heading" class="visually-hidden">Programs</h2>
    <div id="programsGrid" class="program-list">
        @foreach (var prog in programs)
        {
            <div class="program-card-wrapper" data-title="@prog.Title" data-desc="@prog.Desc" data-category="@prog.CategoryId">
                <a asp-controller="@prog.Controller" asp-action="@prog.Action" class="program-row">
                    <span class="program-icon-box"><i class="bi @prog.Icon" aria-hidden="true"></i></span>
                    <span class="program-summary">
                        <span class="program-title">@prog.Title</span>
                        <span class="program-desc">@prog.Desc</span>
                    </span>
                    <svg class="program-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M4 12 12 4M4 4h8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
            </div>
        }
    </div>
    <div id="noResultsMessage" class="text-center py-5" style="display:none;">
        <h3 class="h5">No programs found</h3>
        <p class="text-secondary">Try another search or choose a different category.</p>
    </div>
</section>

