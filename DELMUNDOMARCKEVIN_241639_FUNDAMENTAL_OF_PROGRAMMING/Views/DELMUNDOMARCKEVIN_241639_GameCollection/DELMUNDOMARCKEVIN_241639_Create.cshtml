@model DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Models.DELMUNDOMARCKEVIN_241639_GameCollectionInput
@{
    ViewData["Title"] = "Add Game";
}

<div class="mb-4">
    <h1 class="hero-title">Add Video Game</h1>
    <p class="hero-subtitle mb-0">Record a new title in your gaming catalog with platform and rating.</p>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="apple-card">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()

                <partial name="DELMUNDOMARCKEVIN_241639_Fields" model="Model" />

                <div class="form-actions d-flex align-items-center gap-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-check-lg"></i> Add to Collection
                    </button>
                    <a asp-action="Index" class="btn-apple-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
