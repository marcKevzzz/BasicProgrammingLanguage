@model DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Models.DELMUNDOMARCKEVIN_241639_GameCollectionIndexModel
@{
    ViewData["Title"] = "Game Collection Manager";
    var games = Model.Items;
}

<!-- Header -->
<div class="mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="hero-title">Game Collection Manager</h1>
            <p class="hero-subtitle mb-0">Keep track of your games and play status.</p>
        </div>
        <a asp-action="Create" class="btn-apple-primary">
            <i class="bi bi-plus-lg"></i> Add Game
        </a>
    </div>
</div>

<!-- Search & Status Filter -->
<div class="apple-card shadow-sm p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-12 col-md-6 position-relative">
            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary"></i>
            <input type="text"
                   name="search" aria-label="Search records"
                   value="@Model.Search"
                   class="form-apple-input ps-5"
                   placeholder="Search games by title, genre, or platform..." />
        </div>
        <div class="col-6 col-md-3">
            <select name="status" class="form-apple-select">
                <option value="All">All Completion Statuses</option>
                <option value="Backlog" selected="@(Model.Filter == "Backlog")">Backlog</option>
                <option value="In Progress" selected="@(Model.Filter == "In Progress")">In Progress</option>
                <option value="Completed" selected="@(Model.Filter == "Completed")">Completed</option>
                <option value="Abandoned" selected="@(Model.Filter == "Abandoned")">Abandoned</option>
            </select>
        </div>
        <div class="col-4 col-md-2">
            <button type="submit" class="btn-apple-primary w-100 justify-content-center">
                Filter
            </button>
        </div>
        <div class="col-2 col-md-1">
            <a asp-action="Index" class="btn-apple-secondary w-100 justify-content-center" title="Reset filter" aria-label="Reset filter">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Games Table -->
<div class="apple-card mb-5">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 fw-bold mb-0">Game Library (@games.Count Titles)</h2>
    </div>

    <div class="table-responsive apple-table-container">
        <table class="apple-table">
            <thead>
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Game Title</th>
                    <th>Genre</th>
                    <th>Platform</th>
                    <th>Completion Status</th>
                    <th>Rating</th>
                    <th class="text-end" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (games.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-secondary">
                            <i class="bi bi-controller fs-1 d-block mb-2 opacity-50"></i>
                            No games cataloged yet. Click <strong>Add Game</strong> to record your favorite title!
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var g in games)
                    {
                        int id = g.Id;
                        string st = g.Status?.ToString() ?? "Backlog";
                        int rating = g.Rating;
                        var stBadge = st == "Completed" ? "bg-success text-white" :
                                      st == "In Progress" ? "status-in-progress" :
                                      st == "Backlog" ? "bg-warning text-dark" : "bg-light text-secondary border";

                        <tr>
                            <td class="font-monospace text-secondary">#@id</td>
                            <td class="fw-bold text-primary">@g.Title</td>
                            <td class="text-secondary">@g.Genre</td>
                            <td>
                                <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small">
                                    <i class="bi bi-display me-1"></i> @g.Platform
                                </span>
                            </td>
                            <td>
                                <span class="badge @stBadge rounded-pill px-2 py-1 small fw-semibold">
                                    @st
                                </span>
                            </td>
                            <td>
                                <span class="rating-stars text-warning small" aria-label="@rating out of 5 stars">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        if (s <= rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted"></i>
                                        }
                                    }
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@id" class="btn btn-sm btn-outline-primary rounded-pill px-2" title="Edit game" aria-label="Edit game">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" asp-action="Delete" asp-route-id="@id" class="d-inline" onsubmit="return confirm('Delete this record?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Delete game" aria-label="Delete game">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- How It Works Section -->
<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content">
<div class="row g-4">
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Star Rating Loop Rendering</h6>
            <p class="text-secondary small">
                Ratings are stored as integer values (1 to 5). During view rendering, Razor executes a simple 5-step loop comparing current star index against stored scores to generate golden vector stars.
            </p>
        </div>
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Dynamic Status Milestones</h6>
            <p class="text-secondary small">
                Gamers transition titles through the backlog lifecycle: <strong>Backlog &rarr; In Progress &rarr; Completed / Abandoned</strong> with instant updates saved in-memory.
            </p>
        </div>
    </div>
    </div>
</details>

