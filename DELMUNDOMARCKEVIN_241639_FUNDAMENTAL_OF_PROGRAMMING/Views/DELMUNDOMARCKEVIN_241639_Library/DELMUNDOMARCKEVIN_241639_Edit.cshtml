@model DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Models.DELMUNDOMARCKEVIN_241639_BookEditModel
@{
    ViewData["Title"] = "Edit Book";
    int id = Model.Id;
}

<div class="mb-4">
    <h1 class="hero-title">Edit Book Details</h1>
    <p class="hero-subtitle mb-0">Update book #@id.</p>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="apple-card">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>

            <form method="post" asp-action="Edit" asp-route-id="@id">
                @Html.AntiForgeryToken()

                <partial name="DELMUNDOMARCKEVIN_241639_BookFields" model="Model.Input" />

                <div class="form-actions d-flex align-items-center gap-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn-apple-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
