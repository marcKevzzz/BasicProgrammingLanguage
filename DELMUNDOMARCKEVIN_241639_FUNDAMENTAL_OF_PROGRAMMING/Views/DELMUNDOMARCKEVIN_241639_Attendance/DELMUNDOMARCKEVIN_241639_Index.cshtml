@{
    ViewData["Title"] = "Student Attendance Manager";
    var records = ViewBag.AttendanceList as List<Dictionary<string, object>> ?? new();
}

<!-- Header -->
<div class="mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="hero-title">Student Attendance Manager</h1>
            <p class="hero-subtitle mb-0">Record and review student attendance.</p>
        </div>
        <a asp-action="Create" class="btn-apple-primary">
            <i class="bi bi-person-plus"></i> New Attendance Record
        </a>
    </div>
</div>

<!-- Search & Status Filter -->
<div class="apple-card shadow-sm p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-12 col-md-6 position-relative">
            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary"></i>
            <input type="text" 
                   name="search" aria-label="Search records" 
                   value="@ViewBag.Search" 
                   class="form-apple-input ps-5" 
                   placeholder="Search by student name, number, course, section..." />
        </div>
        <div class="col-6 col-md-3">
            <select name="status" class="form-apple-select">
                <option value="All">All Attendance Statuses</option>
                <option value="Present" selected="@(ViewBag.StatusFilter == "Present")">Present</option>
                <option value="Late" selected="@(ViewBag.StatusFilter == "Late")">Late</option>
                <option value="Absent" selected="@(ViewBag.StatusFilter == "Absent")">Absent</option>
            </select>
        </div>
        <div class="col-4 col-md-2">
            <button type="submit" class="btn-apple-primary w-100 justify-content-center">
                Filter
            </button>
        </div>
        <div class="col-2 col-md-1">
            <a asp-action="Index" class="btn-apple-secondary w-100 justify-content-center" title="Reset filter" aria-label="Reset filter">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Attendance Table -->
<div class="apple-card mb-5">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 fw-bold mb-0">Student Attendance Ledger (@records.Count Students)</h2>
    </div>

    <div class="table-responsive apple-table-container">
        <table class="apple-table">
            <thead>
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Student Name</th>
                    <th>Student Number</th>
                    <th>Course &amp; Section</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th class="text-end" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (records.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-secondary">
                            <i class="bi bi-person-x fs-1 d-block mb-2 opacity-50"></i>
                            No student attendance records found. Click <strong>New Attendance Record</strong> to log one!
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var s in records)
                    {
                        int id = Convert.ToInt32(s["id"]);
                        string st = s["status"]?.ToString() ?? "Present";
                        var stBadge = st == "Present" ? "bg-success text-white" :
                                      st == "Late" ? "bg-warning text-dark" : "bg-danger text-white";

                        <tr>
                            <td class="font-monospace text-secondary">#@id</td>
                            <td class="fw-bold text-primary">@s["name"]</td>
                            <td class="font-monospace text-secondary">@s["studentNumber"]</td>
                            <td>
                                <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 small">
                                    @s["course"] &bull; @s["section"]
                                </span>
                            </td>
                            <td class="font-monospace text-secondary small">@s["date"]</td>
                            <td>
                                <span class="badge @stBadge rounded-pill px-3 py-1 small fw-semibold">
                                    @st
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@id" class="btn btn-sm btn-outline-primary rounded-pill px-2" title="Edit attendance" aria-label="Edit attendance">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" asp-action="Delete" asp-route-id="@id" class="d-inline" onsubmit="return confirm('Delete attendance record for \'@s["name"]\'?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Delete record" aria-label="Delete record">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- How It Works Section -->
<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content">
<div class="row g-4">
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Categorical Status Tiers</h6>
            <p class="text-secondary small">
                Attendance marks evaluate to three standardized classifications: <strong>Present</strong> (punctual participation), <strong>Late</strong> (tardy arrival), and <strong>Absent</strong> (unexcused or excused absence).
            </p>
        </div>
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Classroom Administrative Search</h6>
            <p class="text-secondary small">
                Queries scan both student name fields and alphanumeric student numbers (e.g. <code>2024-01042</code>) to allow rapid roll-call lookup in large lecture sections.
            </p>
        </div>
    </div>
    </div>
</details>

<!-- View C# Logic Section -->
<details class="lesson-details">
    <summary>C# code</summary>
    <div class="lesson-content">
<div class="lesson-body" id="attendLogicPanel">
        <div class="macos-code-box">
            <div class="macos-code-header">
                <div class="traffic-dots">
                    <span class="dot dot-red"></span>
                    <span class="dot dot-yellow"></span>
                    <span class="dot dot-green"></span>
                </div>
                <div class="code-title">DELMUNDOMARCKEVIN_241639_AttendanceController.cs — Search &amp; Filter</div>
                <button type="button" class="btn-copy-code" data-code-target="attendCode">
                    <i class="bi bi-clipboard"></i> Copy Code
                </button>
            </div>
            <pre class="macos-code-body" id="attendCode"><code>public IActionResult Index(string? search, string? status)
{
    var records = _store.GetAll("attendance");

    if (!string.IsNullOrWhiteSpace(search))
    {
        string query = search.Trim().ToLowerInvariant();
        records = records.Where(x =&gt;
            (x.ContainsKey("name") &amp;&amp; x["name"].ToString()!.ToLowerInvariant().Contains(query)) ||
            (x.ContainsKey("studentNumber") &amp;&amp; x["studentNumber"].ToString()!.ToLowerInvariant().Contains(query))
        ).ToList();
    }

    if (!string.IsNullOrWhiteSpace(status) &amp;&amp; status != "All")
    {
        records = records.Where(x =&gt;
            x.ContainsKey("status") &amp;&amp; x["status"].ToString()!.Equals(status, StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }

    ViewBag.AttendanceList = records;
    return View();
}</code></pre>
        </div>
    </div>
    </div>
</details>
