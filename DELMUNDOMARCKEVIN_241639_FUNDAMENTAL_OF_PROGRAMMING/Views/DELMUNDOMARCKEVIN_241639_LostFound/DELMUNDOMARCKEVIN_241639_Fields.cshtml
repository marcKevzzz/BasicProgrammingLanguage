@model DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Models.DELMUNDOMARCKEVIN_241639_LostFoundInput
                <div class="mb-3">
                    <label for="name" class="form-apple-label">Item Name / Title <span class="text-danger">*</span></label>
                    <input type="text" id="name" asp-for="Name" class="form-apple-input" placeholder="e.g. Leather Key Ring with Honda Tag" required />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-apple-label">Detailed Description</label>
                    <textarea id="description" asp-for="Description" class="form-apple-input" rows="3" placeholder="Distinguishing marks, color, stickers, contents..."></textarea>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-apple-label">Location Found / Last Seen <span class="text-danger">*</span></label>
                    <input type="text" id="location" asp-for="Location" class="form-apple-input" placeholder="e.g. North Building Cafeteria, Table 8" required />
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label for="date" class="form-apple-label">Date</label>
                        <input type="date" id="date" asp-for="Date" class="form-apple-input" />
                    </div>
                    <div class="col-6">
                        <label for="status" class="form-apple-label">Status Classification</label>
                        <select id="status" asp-for="Status" class="form-apple-select">
                            <option value="Found">🟢 Found (Item Held Safe)</option>
                            <option value="Lost">🔴 Lost (Owner Searching)</option>
                            <option value="Claimed">⚪ Claimed (Returned)</option>
                        </select>
                    </div>
                </div>
