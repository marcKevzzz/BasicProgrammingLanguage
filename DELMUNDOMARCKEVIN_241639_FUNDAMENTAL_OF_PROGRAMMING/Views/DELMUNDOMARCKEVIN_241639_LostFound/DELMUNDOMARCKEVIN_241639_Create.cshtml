@{
    ViewData["Title"] = "File Lost or Found Report";
}

<div class="mb-4">
    <h1 class="hero-title">File Item Report</h1>
    <p class="hero-subtitle mb-0">Record a lost or recovered personal belonging.</p>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="apple-card">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger rounded-4 border-0 mb-4" role="alert">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                    @ViewBag.Error
                </div>
            }

            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="name" class="form-apple-label">Item Name / Title <span class="text-danger">*</span></label>
                    <input type="text" id="name" name="name" value="@ViewBag.NameInput" class="form-apple-input" placeholder="e.g. Leather Key Ring with Honda Tag" required />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-apple-label">Detailed Description</label>
                    <textarea id="description" name="description" class="form-apple-input" rows="3" placeholder="Distinguishing marks, color, stickers, contents...">@ViewBag.DescriptionInput</textarea>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-apple-label">Location Found / Last Seen <span class="text-danger">*</span></label>
                    <input type="text" id="location" name="location" value="@ViewBag.LocationInput" class="form-apple-input" placeholder="e.g. North Building Cafeteria, Table 8" required />
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label for="date" class="form-apple-label">Date</label>
                        <input type="date" id="date" name="date" value="@(ViewBag.DateInput ?? DateTime.Now.ToString("yyyy-MM-dd"))" class="form-apple-input" />
                    </div>
                    <div class="col-6">
                        <label for="status" class="form-apple-label">Status Classification</label>
                        <select id="status" name="status" class="form-apple-select">
                            <option value="Found" selected>🟢 Found (Item Held Safe)</option>
                            <option value="Lost">🔴 Lost (Owner Searching)</option>
                            <option value="Claimed">⚪ Claimed (Returned)</option>
                        </select>
                    </div>
                </div>

                <div class="form-actions d-flex align-items-center gap-2">
                    <button type="submit" class="btn-apple-primary">
                        <i class="bi bi-check-lg"></i> Submit Report
                    </button>
                    <a asp-action="Index" class="btn-apple-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
