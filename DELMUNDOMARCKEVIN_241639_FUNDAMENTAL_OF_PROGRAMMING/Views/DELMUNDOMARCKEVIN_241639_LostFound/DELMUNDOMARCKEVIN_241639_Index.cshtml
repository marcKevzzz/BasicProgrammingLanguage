@model DELMUNDOMARCKEVIN_241639_FUNDAMENTAL_OF_PROGRAMMING.Models.DELMUNDOMARCKEVIN_241639_LostFoundIndexModel
@{
    ViewData["Title"] = "Lost and Found Tracker";
    var reports = Model.Items;
}

<!-- Header -->
<div class="mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="hero-title">Lost and Found Tracker</h1>
            <p class="hero-subtitle mb-0">Track lost items and their recovery.</p>
        </div>
        <a asp-action="Create" class="btn-apple-primary">
            <i class="bi bi-plus-lg"></i> File New Report
        </a>
    </div>
</div>

<!-- Search & Status Filter -->
<div class="apple-card shadow-sm p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-12 col-md-6 position-relative">
            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary"></i>
            <input type="text"
                   name="search" aria-label="Search records"
                   value="@Model.Search"
                   class="form-apple-input ps-5"
                   placeholder="Search by item name, description, or location..." />
        </div>
        <div class="col-6 col-md-3">
            <select name="status" class="form-apple-select">
                <option value="All">All Statuses</option>
                <option value="Lost" selected="@(Model.Filter == "Lost")">Lost Items</option>
                <option value="Found" selected="@(Model.Filter == "Found")">Found Items</option>
                <option value="Claimed" selected="@(Model.Filter == "Claimed")">Claimed Items</option>
            </select>
        </div>
        <div class="col-4 col-md-2">
            <button type="submit" class="btn-apple-primary w-100 justify-content-center">
                Filter
            </button>
        </div>
        <div class="col-2 col-md-1">
            <a asp-action="Index" class="btn-apple-secondary w-100 justify-content-center" title="Reset filter" aria-label="Reset filter">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Reports Table -->
<div class="apple-card mb-5">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 fw-bold mb-0">Registered Reports (@reports.Count @(reports.Count == 1 ? "Record" : "Records"))</h2>
    </div>

    <div class="table-responsive apple-table-container">
        <table class="apple-table">
            <thead>
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Item Name</th>
                    <th>Description</th>
                    <th>Location</th>
                    <th>Date Reported</th>
                    <th>Status</th>
                    <th class="text-end" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (reports.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-secondary">
                            <i class="bi bi-search-heart fs-1 d-block mb-2 opacity-50"></i>
                            No item reports found. Click <strong>File New Report</strong> to submit an entry!
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var r in reports)
                    {
                        int id = r.Id;
                        string st = r.Status?.ToString() ?? "Found";
                        var stBadge = st == "Found" ? "bg-success-subtle text-success border border-success" :
                                      st == "Lost" ? "bg-danger-subtle text-danger border border-danger" : "bg-light text-secondary border";

                        <tr>
                            <td class="font-monospace text-secondary">#@id</td>
                            <td class="fw-bold text-primary">@r.Name</td>
                            <td class="text-secondary small" style="max-width: 250px;">@r.Description</td>
                            <td><i class="bi bi-geo-alt text-danger me-1"></i> @r.Location</td>
                            <td class="font-monospace text-secondary small">@r.Date</td>
                            <td>
                                <span class="badge @stBadge rounded-pill px-2 py-1 small fw-semibold">
                                    @st
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@id" class="btn btn-sm btn-outline-primary rounded-pill px-2" title="Edit report" aria-label="Edit report">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" asp-action="Delete" asp-route-id="@id" class="d-inline" onsubmit="return confirm('Delete this record?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Delete report" aria-label="Delete report">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- How It Works Section -->
<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content">
<div class="row g-4">
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Incident Reporting Workflow</h6>
            <p class="text-secondary small">
                Every logged belonging records spatial origin details (<code>location</code>) and timestamps (<code>date</code>). As items are identified and returned to legitimate owners, staff update the status property from <strong>Found</strong> or <strong>Lost</strong> to <strong>Claimed</strong>.
            </p>
        </div>
        <div class="col-12 col-md-6">
            <h6 class="fw-bold">Dynamic In-Memory Updates</h6>
            <p class="text-secondary small">
                Edits and deletions are committed directly against the concurrent collection, ensuring that searches executed across open browser tabs reflect accurate state instantly.
            </p>
        </div>
    </div>
    </div>
</details>

