@{
    ViewData["Title"] = "PIN Verification System";
    bool isLocked = ViewBag.IsLocked == true;
    int remaining = ViewBag.RemainingAttempts ?? 3;
    string demoPin = ViewBag.DemoPin ?? "";
}

<!-- Header -->
<div class="mb-4">
    <h1 class="hero-title">PIN Verification System</h1>
    <p class="hero-subtitle mb-0">Enter the PIN. You have three attempts.</p>
</div>

<div class="row g-4 mb-5">
    <!-- Keypad Input Section -->
    <div class="col-12 col-lg-5">
        <div class="apple-card h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock fs-5 text-primary"></i>
                    <h2 class="h5 fw-bold mb-0">Security Terminal</h2>
                </div>
                <span class="apple-badge @(isLocked ? "badge-advanced" : remaining == 1 ? "badge-intermediate" : "badge-beginner")">
                    @(isLocked ? "TERMINAL LOCKED" : $"{remaining} Attempt(s) Left")
                </span>
            </div>

            @if (isLocked)
            {
                <div class="alert alert-danger rounded-4 py-4 text-center border-0 shadow-sm mb-3">
                    <i class="bi bi-shield-slash-fill fs-1 text-danger d-block mb-2"></i>
                    <h5 class="fw-bold">Security Lockout Active</h5>
                    <p class="small mb-3">The terminal has engaged lockout protection after 3 failed PIN attempts.</p>
                    <form method="post" asp-action="PinVerification">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="reset" />
                        <button type="submit" class="btn-apple-primary">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset Terminal Demo
                        </button>
                    </form>
                </div>
            }
            else
            {
                <form method="post" asp-action="PinVerification" id="pinForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-3 text-center">
                        <label for="pinInput" class="form-apple-label">Enter 4-Digit Security PIN</label>
                        <input type="password" 
                               id="pinInput" 
                               name="pin" 
                               maxlength="4" 
                               class="form-apple-input fs-2 text-center font-monospace fw-bold tracking-widest py-2" 
                               placeholder="••••" 
                               autocomplete="off" 
                               required />
                    </div>

                    <!-- Touch Screen Keypad Simulation -->
                    <div class="row g-2 mb-3 pin-keypad">
                        @for (int i = 1; i <= 9; i++)
                        {
                            int num = i;
                            <div class="col-4">
                                <button type="button" class="btn-apple-secondary w-100 py-2 fs-5 fw-bold keypad-btn" data-val="@num">@num</button>
                            </div>
                        }
                        <div class="col-4">
                            <button type="button" class="btn-apple-secondary w-100 py-2 keypad-clear" aria-label="Delete last PIN digit"><i class="bi bi-backspace"></i></button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn-apple-secondary w-100 py-2 fs-5 fw-bold keypad-btn" data-val="0">0</button>
                        </div>
                        <div class="col-4">
                            <button type="submit" class="btn-apple-primary w-100 py-2" aria-label="Verify PIN"><i class="bi bi-check-lg"></i></button>
                        </div>
                    </div>

                </form>

                <div class="mt-3 pt-3 border-top">
                    <form method="post" asp-action="PinVerification">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="reset" />
                        <button type="submit" class="btn btn-sm btn-apple-secondary w-100">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset Demo Attempts
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Output Section -->
    <div class="col-12 col-lg-7">
        <div class="apple-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="h5 fw-bold mb-0">Terminal Response Status</h2>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small">
                        Session Protected
                    </span>
                </div>

            <div class="pin-reference mb-3">
                <label for="practicePin" class="form-apple-label mb-0">Practice PIN</label>
                <div class="password-field">
                    <input id="practicePin" type="password" value="@demoPin" class="form-apple-input font-monospace" readonly aria-label="Practice PIN" />
                    <button type="button" id="togglePracticePin" class="password-visibility" aria-label="Show practice PIN" aria-pressed="false" aria-controls="practicePin"><i class="bi bi-eye" aria-hidden="true"></i></button>
                </div>
            </div>

                <!-- Attempt Indicators (3 Dots) -->
                <div class="p-3 rounded-4 bg-light border mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-semibold text-secondary text-uppercase">Attempt Quota Status</span>
                        <span class="small fw-bold @(remaining == 0 ? "text-danger" : "text-dark")">@remaining / 3 attempts remaining</span>
                    </div>
                    <div class="d-flex gap-2">
                        <div class="flex-grow-1 p-2 rounded-3 text-center small fw-semibold @(remaining >= 1 ? "bg-success text-white" : "bg-danger text-white")">
                            Attempt 1 @(remaining >= 1 ? "✓" : "✗")
                        </div>
                        <div class="flex-grow-1 p-2 rounded-3 text-center small fw-semibold @(remaining >= 2 ? "bg-success text-white" : "bg-danger text-white")">
                            Attempt 2 @(remaining >= 2 ? "✓" : "✗")
                        </div>
                        <div class="flex-grow-1 p-2 rounded-3 text-center small fw-semibold @(remaining >= 3 ? "bg-success text-white" : "bg-danger text-white")">
                            Attempt 3 @(remaining >= 3 ? "✓" : "✗")
                        </div>
                    </div>
                </div>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger rounded-4 border-0 shadow-sm py-3 mb-3" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-x-circle-fill fs-4 text-danger"></i>
                            <span class="fw-semibold">@ViewBag.Error</span>
                        </div>
                    </div>
                }

                @if (ViewBag.Message != null)
                {
                    var msgType = ViewBag.MessageType?.ToString() ?? "info";
                    <div class="alert @(msgType == "success" ? "alert-success" : "alert-info") rounded-4 border-0 shadow-sm py-3 mb-3" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi @(msgType == "success" ? "bi-check-circle-fill text-success" : "bi-info-circle-fill text-primary") fs-4"></i>
                            <span class="fs-5 fw-semibold">@ViewBag.Message</span>
                        </div>
                    </div>
                }
                else if (ViewBag.Error == null)
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="bi bi-shield-check fs-1 mb-2 d-block opacity-50"></i>
                        <p class="mb-0">Reveal the practice PIN with the eye button, then enter it using the keypad.</p>
                    </div>
                }


            </div>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<details class="lesson-details">
    <summary>How it works</summary>
    <div class="lesson-content"><p class="text-secondary mb-0">The do…while loop checks each submitted PIN and decreases the remaining attempts after a wrong entry. It stops when a PIN matches, when all supplied entries are used, or after three failed attempts. All entries are validated before any attempt is consumed. This is a practice demo; use the displayed PIN.</p></div>
</details>
<details class="lesson-details">
    <summary>C# code</summary>
    <div class="lesson-content">
        <div class="macos-code-box">
            <div class="macos-code-header">
                <div class="code-title">DELMUNDOMARCKEVIN_241639_RepetitionController.cs — PinVerification</div>
                <button type="button" class="btn-copy-code" data-code-target="PinVerificationCode">Copy code</button>
            </div>
            <pre class="macos-code-body" id="PinVerificationCode"><code>public IActionResult PinVerification(string? pin, string? action)
{
    EnsurePinSession();
    ViewBag.DemoPin = CurrentPin;
    if (action == "reset")
    {
        HttpContext.Session.SetInt32("PinRemaining", 3);
        HttpContext.Session.SetInt32("PinLocked", 0);
        ViewBag.RemainingAttempts = 3;
        ViewBag.IsLocked = false;
        ViewBag.Message = "Demo reset. You have three attempts.";
        return View();
    }
    int remaining = HttpContext.Session.GetInt32("PinRemaining") ?? 3;
    ViewBag.RemainingAttempts = remaining;
    ViewBag.IsLocked = HttpContext.Session.GetInt32("PinLocked") == 1;
    if (ViewBag.IsLocked)
    {
        ViewBag.Error = "The demo is locked. Reset it to try again.";
        return View();
    }
    var attempts = (pin ?? "").Split(',', StringSplitOptions.TrimEntries);
    if (!ModelState.IsValid || string.IsNullOrWhiteSpace(pin) || pin.Length &gt; 30 || attempts.Length &gt; 3 ||
        attempts.Any(value =&gt; value.Length != 4 || !value.All(char.IsAsciiDigit)))
    {
        ViewBag.Error = "Enter 1–3 four-digit PINs, separated by commas.";
        return View();
    }
    var history = new List&lt;string&gt;();
    int index = 0;
    bool verified;
    do
    {
        verified = attempts[index] == CurrentPin;
        history.Add($"Attempt {4 - remaining}: " + (verified ? "Access granted" : "Incorrect PIN"));
        if (!verified) remaining--;
        index++;
    } while (index &lt; attempts.Length &amp;&amp; !verified &amp;&amp; remaining &gt; 0);

    HttpContext.Session.SetInt32("PinRemaining", verified ? 3 : remaining);
    HttpContext.Session.SetInt32("PinLocked", remaining == 0 ? 1 : 0);
    ViewBag.History = history;
    ViewBag.RemainingAttempts = verified ? 3 : remaining;
    ViewBag.IsLocked = remaining == 0;
    ViewBag.Success = verified;
    if (verified) ViewBag.Message = "Access granted. PIN verified.";
    else ViewBag.Error = remaining == 0 ? "Three incorrect attempts. The demo is locked." : $"Incorrect PIN. {remaining} attempts remaining.";
    return View();
}

private void EnsurePinSession()
{
    if (HttpContext.Session.GetString("DemoPin") == null)
        HttpContext.Session.SetString("DemoPin", System.Security.Cryptography.RandomNumberGenerator.GetInt32(10000).ToString("D4"));
    if (!HttpContext.Session.GetInt32("PinRemaining").HasValue)
    {
        HttpContext.Session.SetInt32("PinRemaining", 3);
        HttpContext.Session.SetInt32("PinLocked", 0);
    }
}

private string CurrentPin =&gt; HttpContext.Session.GetString("DemoPin")!;</code></pre>
        </div>
    </div>
</details>

@section Scripts {
    <script>
        document.getElementById('togglePracticePin').addEventListener('click', event => {
            const field = document.getElementById('practicePin');
            const button = event.currentTarget;
            const visible = field.type === 'password';
            field.type = visible ? 'text' : 'password';
            button.setAttribute('aria-label', visible ? 'Hide practice PIN' : 'Show practice PIN');
            button.setAttribute('aria-pressed', String(visible));
            button.querySelector('i').className = visible ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
        const pinInput = document.getElementById('pinInput');
        if (pinInput) {
            document.querySelectorAll('.keypad-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    if (pinInput.value.length < 4) {
                        pinInput.value += btn.getAttribute('data-val');
                    }
                });
            });

            const clearBtn = document.querySelector('.keypad-clear');
            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    pinInput.value = pinInput.value.slice(0, -1);
                });
            }
        }
    </script>
}
